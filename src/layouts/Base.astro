---
import '../styles/tailwind.css';
import '../styles/tokens.css';
import ThemeProvider from '../components/ThemeProvider.astro';
import Navbar from '../components/Navbar.astro';
import Analytics from '@vercel/analytics/astro';
import { readFileSync } from 'fs';
import { resolve } from 'path';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Esconde a Navbar (ex: páginas de erro) */
  hideNavbar?: boolean;
  /** Esconde o rodapé em páginas full-screen ou experiências imersivas */
  hideFooter?: boolean;
  noindex?: boolean;
}

const SITE = 'https://devsaderiva.com.br';

const {
  title = 'Devs à Deriva',
  description = 'Devs à Deriva é um blog sobre tecnologia, carreira, cultura nerd e vida real no desenvolvimento de software.',
  ogImage = `${SITE}/logo-high-color.webp`,
  ogType = 'website',
  hideNavbar = false,
  hideFooter = false,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Devs à Deriva',
  url: SITE,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE}/logo-high-color.webp`,
  },
  description: 'Blog sobre tecnologia, carreira, cultura nerd e vida real no desenvolvimento de software.',
  sameAs: [
    'https://www.instagram.com/devsaderiva',
  ],
};

const adminRaw = readFileSync(resolve('./public/astronaut-admin.svg'), 'utf-8');
const adminSvgInline = adminRaw
  .replace(/<\?xml[^?]*\?>\s*/g, '')
  .replace(/<!DOCTYPE[^>]*>\s*/g, '')
  .replace(/width="[^"]*"/, 'width="48"')
  .replace(/height="[^"]*"/, 'height="48"');

function getCurrentYear() {
  return new Date().getFullYear();
}
---

<html lang="pt-BR" data-theme="orbita-baixa" style="background-color: #020b18;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Devs à Deriva" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/helmet.svg" />

    <!-- AEO/GEO: recursos para AI crawlers -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs summary" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs full content" />
    <link rel="alternate" type="application/json" href="/ai-index.json" title="AI content index" />
    <link rel="alternate" type="application/json" href="/docs.json" title="Site documentation manifest" />

    <!-- Schema.org: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Slot para schemas e meta extras por página -->
    <slot name="head" />

    <Analytics />
    <ThemeProvider />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z8ENDKWVWC" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Z8ENDKWVWC');
    </script>
  </head>
  <body class="m-0 p-0 overflow-x-hidden">
    <a href="#main-content" class="skip-to-content">Pular para o conteúdo</a>
    {!hideNavbar && <Navbar />}
    <slot />

    {!hideNavbar && !hideFooter && (
      <footer class="site-footer" aria-label="Links institucionais">
        <nav class="site-footer-nav" aria-label="Links legais">
          <a href="/termos#main-content">Termos de Uso</a>
          <a href="/privacidade#main-content">Política de Privacidade</a>
          <a href="mailto:leandrodukievicz1718@gmail.com">Contato</a>
        </nav>
        <p class="site-footer-copy">© {getCurrentYear()} Devs à Deriva</p>
      </footer>
    )}

    <div id="admin-wrap">
      <div id="admin-cta" aria-label="Acessar painel administrativo">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <rect x="9" y="11" width="6" height="5" rx="1"/>
          <path d="M12 11V8a2 2 0 0 0-2-2H10a2 2 0 0 0-2 2v3"/>
          <circle cx="12" cy="13.5" r="0.8" fill="currentColor" stroke="none"/>
        </svg>
      </div>
      <a
        href="https://dashboard.devsaderiva.com.br/"
        id="admin-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Entrar no painel"
      >
        <span class="admin-svg" set:html={adminSvgInline}></span>
        <span class="admin-label">Admin</span>
      </a>
    </div>

    <button id="back-to-top" aria-label="Voltar ao topo">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>

    {!hideNavbar && (
      <aside
        id="cookie-consent"
        class="cookie-consent"
        aria-label="Aviso de cookies"
        aria-live="polite"
        hidden
      >
        <p>
          Usamos cookies e tecnologias semelhantes para manter o site funcionando, entender visitas
          e melhorar a experiência.
          <a href="/privacidade#main-content">Ver Política de Privacidade</a>.
        </p>
        <button id="cookie-consent-accept" type="button">Entendi</button>
      </aside>
    )}
  </body>
</html>

<style>
  .skip-to-content {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 9999;
    padding: 8px 16px;
    font-family: monospace;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-bg);
    background: var(--color-accent);
    border-radius: 0 0 6px 6px;
    text-decoration: none;
    transition: top 0.15s ease;
  }

  .skip-to-content:focus-visible {
    top: 0;
    outline: 2px solid var(--color-star);
    outline-offset: 2px;
  }

  .site-footer {
    position: relative;
    z-index: 10;
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    padding: 36px 0 44px;
    border-top: 1px solid var(--color-star-12);
    color: var(--color-text);
  }

  .site-footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
  }

  .site-footer-nav a {
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-star);
    text-decoration: none;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .site-footer-nav a:hover,
  .site-footer-nav a:focus-visible {
    color: var(--color-accent);
    text-shadow: 0 0 12px var(--color-accent-40);
    outline: none;
  }

  .site-footer-nav a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .site-footer-copy {
    margin: 14px 0 0;
    font-family: monospace;
    font-size: 0.68rem;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    opacity: 0.5;
  }

  .cookie-consent {
    position: fixed;
    right: 24px;
    bottom: 24px;
    left: 24px;
    z-index: 180;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: min(920px, calc(100% - 48px));
    margin: 0 auto;
    padding: 16px 18px;
    border: 1px solid var(--color-star-22);
    border-radius: 8px;
    background: var(--color-bg-95);
    box-shadow: 0 18px 45px rgb(0 0 0 / 0.42), 0 0 24px var(--color-star-08);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--color-text);
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent p {
    margin: 0;
    max-width: 72ch;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--color-text);
    opacity: 0.82;
  }

  .cookie-consent a {
    color: var(--color-star);
    text-decoration: none;
    border-bottom: 1px solid var(--color-star-40);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .cookie-consent a:hover,
  .cookie-consent a:focus-visible {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    outline: none;
  }

  .cookie-consent button {
    flex: 0 0 auto;
    padding: 9px 15px;
    border: 1px solid var(--color-star);
    border-radius: 6px;
    background: transparent;
    color: var(--color-star);
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .cookie-consent button:hover,
  .cookie-consent button:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 14px var(--color-accent-30);
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @keyframes admin-blink {
    0%   { opacity: 1; }
    30%  { opacity: 0; }
    60%  { opacity: 0; }
    100% { opacity: 1; }
  }

  #admin-wrap {
    position: fixed;
    top: 4px;
    right: 4px;
    z-index: 150;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  #admin-cta {
    width: 29px;
    height: 29px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-star);
    cursor: pointer;
    animation: admin-blink 4s ease-in-out infinite;
    transition: opacity 1.5s ease, color 0.22s ease, filter 0.22s ease, transform 0.22s ease;
    flex-shrink: 0;
  }

  #admin-wrap:hover #admin-cta {
    animation: none;
    opacity: 0;
    pointer-events: none;
  }

  #admin-cta svg {
    width: 17px;
    height: 17px;
  }

  #admin-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-12px);
    transition: opacity 1.5s ease, transform 1.5s ease;
    order: -1;
  }

  #admin-wrap:hover #admin-link {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  #admin-link .admin-svg {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-star);
    filter: drop-shadow(0 0 6px var(--color-star-40));
  }

  #admin-link .admin-svg :global(svg) {
    display: block;
    width: 29px;
    height: 29px;
    color: var(--color-star);
  }

  #admin-link .admin-svg :global(svg *) {
    fill: var(--color-star);
    stroke: var(--color-star);
  }

  @media (max-width: 480px) {
    #admin-wrap {
      top: auto;
      right: auto;
      bottom: 14px;
      left: 14px;
      flex-direction: row;
    }

    #admin-link {
      order: 1;
      transform: translateX(-12px);
    }

    #admin-wrap:hover #admin-link {
      transform: translateX(0);
    }
  }

  #admin-link .admin-svg :global(#antenna-left) {
    fill: var(--color-star);
    transform-box: fill-box;
    transform-origin: center;
    transition: fill 0.22s ease, filter 0.22s ease;
  }

  #admin-link:hover .admin-svg :global(#antenna-left) {
    animation: gear-spin 3s linear infinite;
    fill: var(--color-accent);
    filter: drop-shadow(0 0 8px var(--color-accent-40));
  }

  @keyframes gear-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  #admin-link .admin-label {
    font-family: monospace;
    font-size: 0.48rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-star);
    white-space: nowrap;
    margin-top: 2px;
  }

  #admin-link .nav-prefix {
    color: var(--color-star);
    margin-right: 1px;
  }

  #back-to-top {
    position: fixed;
    bottom: 32px;
    right: 32px;
    z-index: 150;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px outset var(--color-star);
    border-radius: 50%;
    color: var(--color-star);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.35s ease, transform 0.35s ease, visibility 0.35s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #back-to-top:hover,
  #back-to-top:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 14px var(--color-accent-30);
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  #back-to-top svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 768px) {
    :global(body),
    :global(body *) {
      color: #ffffff !important;
    }

    .site-footer {
      padding-bottom: 82px;
    }

    .cookie-consent {
      right: 16px;
      bottom: 16px;
      left: 16px;
      width: calc(100% - 32px);
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }

    .cookie-consent button {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .site-footer {
      width: min(100% - 32px, 1120px);
      padding-top: 28px;
    }

    .site-footer-nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>

<script>
  const COOKIE_CONSENT_KEY = 'dda-cookie-consent-v1';
  const cookieConsent = document.getElementById('cookie-consent');
  const cookieAccept = document.getElementById('cookie-consent-accept');

  try {
    if (cookieConsent && localStorage.getItem(COOKIE_CONSENT_KEY) !== 'accepted') {
      cookieConsent.hidden = false;
    }
  } catch (_) {
    if (cookieConsent) cookieConsent.hidden = false;
  }

  cookieAccept?.addEventListener('click', () => {
    try {
      localStorage.setItem(COOKIE_CONSENT_KEY, 'accepted');
    } catch (_) {}
    if (cookieConsent) cookieConsent.hidden = true;
  });

  const btn = document.getElementById('back-to-top');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      btn?.classList.add('is-visible');
    } else {
      btn?.classList.remove('is-visible');
    }
  }, { passive: true });

  btn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
