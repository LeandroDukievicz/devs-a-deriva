---
import type { CategoryMeta } from '../lib/categories';
import type { Post } from '../types/blog';
import { CATEGORY_POSTS_PER_PAGE } from '../lib/post-listing';
import PostCarousel from './PostCarousel.astro';
import PostFeed from './PostFeed.astro';

interface Props { category: CategoryMeta; posts: readonly Post[]; currentPage?: number }
const { category, posts, currentPage = 1 } = Astro.props;
const totalPages = Math.max(1, Math.ceil(posts.length / CATEGORY_POSTS_PER_PAGE));
const start = (currentPage - 1) * CATEGORY_POSTS_PER_PAGE;
const pagePosts = posts.slice(start, start + CATEGORY_POSTS_PER_PAGE);
---

<main id="main-content" class="categoria-page" data-category={category.slug}>
  <div class="categoria-content">
    <header class="categoria-header">
      <div class="categoria-info">
        <h1 class="categoria-title"><span class="cat-prefix" aria-hidden="true">&gt;_</span>{category.label}</h1>
        <p class="categoria-desc">{category.description}</p>
        <span class="categoria-count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
      </div>
      <img class="categoria-illustration" src={category.illustration} alt="" width="160" height="160" decoding="async" />
    </header>
    {currentPage === 1 && <PostCarousel posts={posts} origin="category" headingLevel={2} />}
    <PostFeed
      posts={pagePosts}
      currentPage={currentPage}
      totalPages={totalPages}
      basePath={`/categorias/${category.slug}`}
      title={`Posts de ${category.label}`}
      origin="category"
    />
  </div>
</main>

<style>
  .categoria-page { position: relative; z-index: 10; min-height: 100vh; padding: 132px 24px 64px; }
  .categoria-content { display: flex; flex-direction: column; gap: 64px; width: min(100%, 1440px); min-width: 0; margin-inline: auto; }
  .categoria-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 180px; padding: 24px 32px; border: 1px solid var(--color-star-22); border-radius: 8px; background: var(--color-bg-88); }
  .categoria-info { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; min-width: 0; }
  .categoria-title { margin: 0; color: var(--color-text); font: 600 clamp(1.4rem, 3vw, 2.2rem)/1.25 monospace; overflow-wrap: anywhere; }
  .cat-prefix { margin-right: 8px; color: var(--color-accent); }
  .categoria-desc { max-width: 70ch; margin: 0; color: var(--color-reading-text); font: .85rem/1.7 monospace; }
  .categoria-count { color: var(--color-star); font: .7rem/1.4 monospace; letter-spacing: .06em; text-transform: uppercase; }
  .categoria-illustration { flex-shrink: 0; width: clamp(100px, 12vw, 160px); height: clamp(100px, 12vw, 160px); object-fit: contain; }
  @media (max-width: 768px) {
    .categoria-page { padding: 100px 16px 48px; }
    .categoria-content { gap: 48px; }
    .categoria-header { padding: 24px; min-height: 0; }
    .categoria-illustration { width: 86px; height: 86px; }
  }
  @media (max-width: 540px) {
    .categoria-header { gap: 12px; padding: 20px; }
    .categoria-desc { font-size: .73rem; }
    .categoria-illustration { width: 62px; height: 62px; align-self: flex-start; }
  }
</style>
