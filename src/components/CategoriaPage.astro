---
import { getFeaturedByCategory, getPostsByCategory, isApiOffline, paginatePosts } from '../lib/posts';

interface Props {
  category: string;
  categorySlug: string;
  description: string;
  cornerIllustration?: string;
  animateIllustration?: boolean;
}

const {
  category,
  categorySlug,
  description,
  cornerIllustration,
  animateIllustration = false,
} = Astro.props;

const featuredPosts = await getFeaturedByCategory(categorySlug);
const allPosts = await getPostsByCategory(categorySlug);
const PAGE_SIZE = 10;
const firstPage = paginatePosts(allPosts, 1, PAGE_SIZE);
const visiblePosts = firstPage.items;
const nextPageHref = firstPage.hasMore ? `/categorias/${categorySlug}/pagina/2/` : null;
---

<main id="main-content" class="categoria-page">
  {cornerIllustration && (
    <div
      class={`categoria-corner-illustration${animateIllustration ? ' is-animated' : ''}`}
      aria-hidden="true"
    >
      <span
        class="corner-astronaut"
        style={`--corner-illustration: url("${cornerIllustration}")`}
      ></span>
    </div>
  )}

  <!-- ── Header ─────────────────────────────────────────────────── -->
  <header class="categoria-header">
    <div class="categoria-info">
      <h1 class="categoria-title">
        <span class="cat-prefix">&gt;_</span>{category}
      </h1>
      <p class="categoria-desc">{description}</p>
      <span class="categoria-count">{allPosts.length} {allPosts.length === 1 ? 'post' : 'posts'}</span>
    </div>
  </header>

  <div class="categoria-divider"></div>

  {allPosts.length === 0 && (
    <div class="empty-state">
      <p>{isApiOffline()
        ? '> api indisponível no momento do build. tente novamente mais tarde.'
        : '> nenhum post nesta categoria ainda. volte em breve.'
      }</p>
    </div>
  )}

  <!-- ── Destaques ──────────────────────────────────────────────── -->
  <section class="destaques-section">
    <div class="section-label">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/>
      </svg>
      DESTAQUES DA CATEGORIA
    </div>

    <div class="carousel-wrapper">
      <button class="carousel-btn prev" id="carousel-prev" aria-label="Anterior">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>

      <div class="carousel-viewport">
        <div class="carousel-track" id="carousel-track">
          {featuredPosts.map((post, i) => (
            <a href={`/posts/${post.slug}?from=category`} class="feat-card" data-index={i}>
              <div class="feat-card-body">
                <span class="card-tag">{category.toUpperCase()}</span>
                <h3 class="feat-card-title">{post.title}</h3>
                <div class="card-meta">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  {post.readTime}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <button class="carousel-btn next" id="carousel-next" aria-label="Próximo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
    </div>

    <div class="carousel-dots" id="carousel-dots"></div>
  </section>

  <!-- ── Todos os Posts ─────────────────────────────────────────── -->
  <section class="posts-section">
    <div class="section-label">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
        <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
      </svg>
      TODOS OS POSTS
    </div>

    <div class="posts-grid">
      {visiblePosts.map(post => (
        <a href={`/posts/${post.slug}?from=category`} class="post-card">
          <div class="post-card-body">
            <span class="card-tag">{category.toUpperCase()}</span>
            <h3 class="post-card-title">{post.title}</h3>
            <p class="post-card-excerpt">{post.excerpt}</p>
            <div class="post-card-meta">
              <div class="card-meta">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
                {post.readTime}
              </div>
              <span class="post-hashtag">{post.hashtag}</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="load-more-wrap">
      <div id="category-posts-sentinel" aria-hidden="true"></div>
      <div id="category-posts-loading" class="category-loading" hidden aria-label="Carregando posts">carregando...</div>
      <button class="load-more-btn" type="button" hidden={!firstPage.hasMore}>
        CARREGAR MAIS POSTS
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
        </svg>
      </button>
      {nextPageHref && <a id="category-next-page-link" class="category-next-page-link" href={nextPageHref} rel="next">abrir página 2</a>}
      <p id="category-load-error" class="category-load-error" hidden>
        Falha ao carregar. <button class="category-retry-btn" type="button">Tentar novamente</button>
      </p>
      <p id="category-end-of-feed" class="category-end-of-feed" hidden={allPosts.length === 0 || firstPage.hasMore}>
        Você chegou ao fundo do mar.
      </p>
    </div>
    <div id="category-posts-status" class="sr-only" aria-live="polite" aria-atomic="true"></div>
  </section>
  <noscript><style>.load-more-btn{display:none}</style></noscript>
</main>

<script is:inline id="categoria-data" type="application/json" set:html={JSON.stringify({ category, categorySlug, pageSize: PAGE_SIZE, hasMore: firstPage.hasMore }).replace(/</g, '\\u003c').replace(/>/g, '\\u003e')} />

<style is:global>
  #nav-logo-link {
    display: none !important;
  }
</style>

<style is:global>
  .categoria-page .posts-grid {
    grid-auto-rows: 260px;
  }

  .categoria-page .post-card {
    height: 100%;
    overflow: hidden;
  }

  .categoria-page .post-card-body {
    height: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .categoria-page .post-card-title {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .categoria-page .post-card-excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .categoria-page .post-card-meta {
    margin-top: auto;
  }

  @media (max-width: 600px) {
    .categoria-page .posts-grid {
      grid-auto-rows: 280px;
    }
  }
</style>

<script>
  document.querySelector<HTMLElement>('.categoria-page')?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const postLink = target?.closest<HTMLAnchorElement>('.feat-card[href*="/posts/"], .post-card[href*="/posts/"]');
    if (postLink) sessionStorage.setItem('post-nav-origin', 'category');
  });
</script>

<script>
  const { category, categorySlug, pageSize, hasMore: initialHasMore } = JSON.parse(
    (document.getElementById('categoria-data') as HTMLScriptElement).text
  ) as { category: string; categorySlug: string; pageSize: number; hasMore: boolean };
  let currentPage = 1;
  let hasMore = initialHasMore;
  let isLoading = false;
  let observer: IntersectionObserver | null = null;

  const loadMoreButton = document.querySelector<HTMLButtonElement>('.load-more-btn');
  const nextPageLink = document.getElementById('category-next-page-link') as HTMLAnchorElement | null;
  const postsGrid = document.querySelector('.posts-grid');
  const sentinel = document.getElementById('category-posts-sentinel');
  const loading = document.getElementById('category-posts-loading');
  const error = document.getElementById('category-load-error');
  const endOfFeed = document.getElementById('category-end-of-feed');
  const status = document.getElementById('category-posts-status');
  const loadedSlugs = new Set(
    Array.from(document.querySelectorAll<HTMLAnchorElement>('.posts-grid .post-card[href*="/posts/"]'))
      .map((link) => {
        const parts = link.pathname.split('/').filter(Boolean);
        return parts[parts.length - 1];
      })
      .filter((slug): slug is string => Boolean(slug))
  );

  type CatPost = { slug: string; title: string; excerpt: string; readTime: string; hashtag: string };

  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function renderPostCard(post: CatPost): string {
    return `
      <a href="/posts/${escapeHtml(post.slug)}?from=category" class="post-card">
        <div class="post-card-body">
          <span class="card-tag">${escapeHtml(category.toUpperCase())}</span>
          <h3 class="post-card-title">${escapeHtml(post.title)}</h3>
          <p class="post-card-excerpt">${escapeHtml(post.excerpt)}</p>
          <div class="post-card-meta">
            <div class="card-meta">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
              ${escapeHtml(post.readTime)}
            </div>
            <span class="post-hashtag">${escapeHtml(post.hashtag)}</span>
          </div>
        </div>
      </a>
    `;
  }

  function setLoadingState(loadingState: boolean) {
    if (loadingState) {
      loadMoreButton?.setAttribute('hidden', '');
      loading?.removeAttribute('hidden');
      return;
    }

    loading?.setAttribute('hidden', '');
    if (hasMore) loadMoreButton?.removeAttribute('hidden');
  }

  function updateNextPageLink() {
    if (!nextPageLink) return;
    if (!hasMore) {
      nextPageLink.setAttribute('hidden', '');
      return;
    }

    const nextPage = currentPage + 1;
    nextPageLink.href = `/categorias/${encodeURIComponent(categorySlug)}/pagina/${nextPage}/`;
    nextPageLink.textContent = `abrir página ${nextPage}`;
    nextPageLink.removeAttribute('hidden');
  }

  function showEndOfFeed() {
    hasMore = false;
    loadMoreButton?.setAttribute('hidden', '');
    nextPageLink?.setAttribute('hidden', '');
    loading?.setAttribute('hidden', '');
    endOfFeed?.removeAttribute('hidden');
    if (status) status.textContent = 'Você chegou ao fundo do mar.';
    if (sentinel) observer?.unobserve(sentinel);
  }

  async function loadNextPage() {
    if (isLoading || !hasMore) return;
    isLoading = true;
    error?.setAttribute('hidden', '');
    setLoadingState(true);

    try {
      const response = await fetch(`/api/posts.json?category=${encodeURIComponent(categorySlug)}&page=${currentPage + 1}&limit=${pageSize}`);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const data = await response.json() as {
        posts: CatPost[];
        currentPage: number;
        hasNextPage: boolean;
      };

      const nextPosts = data.posts.filter((post) => !loadedSlugs.has(post.slug));
      if (nextPosts.length > 0 && postsGrid) {
        postsGrid.insertAdjacentHTML('beforeend', nextPosts.map(renderPostCard).join(''));
        nextPosts.forEach((post) => loadedSlugs.add(post.slug));
        if (status) {
          status.textContent = `${nextPosts.length} posts carregados.`;
          setTimeout(() => { status.textContent = ''; }, 2000);
        }
      }

      currentPage = data.currentPage;
      hasMore = data.hasNextPage;
      setLoadingState(false);
      updateNextPageLink();

      if (!hasMore) showEndOfFeed();
    } catch {
      setLoadingState(false);
      error?.removeAttribute('hidden');
      isLoading = false;
      return;
    }

    isLoading = false;
  }

  if ('IntersectionObserver' in window) {
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) loadNextPage();
        }
      },
      { rootMargin: '0px 0px 300px 0px' },
    );

    if (sentinel && hasMore) observer.observe(sentinel);
  }

  loadMoreButton?.addEventListener('click', loadNextPage);
  error?.querySelector<HTMLButtonElement>('.category-retry-btn')?.addEventListener('click', () => {
    error.setAttribute('hidden', '');
    loadNextPage();
  });
</script>

<style>
  /* ── Page wrapper ──────────────────────────────────────────── */
  .categoria-page {
    position: relative;
    z-index: 10;
    min-height: 100vh;
    padding-top: 72px;
  }

  .categoria-corner-illustration {
    position: absolute;
    top: 82px;
    right: 28px;
    z-index: -1;
    width: min(18.6vw, 211px);
    aspect-ratio: 3 / 2;
    pointer-events: none;
    color: var(--color-star);
    opacity: 0.34;
  }

  .corner-astronaut {
    position: absolute;
    inset: 0;
    display: block;
    background: var(--color-star);
    filter: drop-shadow(0 0 18px var(--color-star-45));
    mask-image: var(--corner-illustration);
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    -webkit-mask-image: var(--corner-illustration);
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    transform-origin: 50% 50%;
    opacity: 0.58;
  }

  .categoria-corner-illustration.is-animated .corner-astronaut {
    animation: astronaut-float 7.5s ease-in-out infinite;
  }

  @keyframes astronaut-float {
    0%, 100% {
      transform: translate3d(0, 0, 0) rotate(-0.6deg);
    }
    50% {
      transform: translate3d(-3px, -14px, 0) rotate(0.8deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .corner-astronaut {
      animation: none;
    }
  }

  .empty-state {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
  }

  .empty-state p {
    font-family: monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--color-star);
    opacity: 0.35;
    margin: 0;
  }

  /* ── Header ────────────────────────────────────────────────── */
  .categoria-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
    padding: 24px 48px 28px;
  }

  .categoria-info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    opacity: 0;
    animation: cat-fade-info 0.65s ease 0.25s forwards;
  }

  @keyframes cat-fade-info {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .categoria-title {
    margin: 0;
    font-family: monospace;
    font-size: clamp(1.3rem, 3.5vw, 2.2rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-star);
    text-shadow: 0 0 20px var(--color-star-40);
    line-height: 1.1;
  }

  .cat-prefix {
    color: var(--color-accent);
    margin-right: 6px;
  }

  .categoria-desc {
    margin: 0;
    font-family: monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-star);
    opacity: 0.5;
    line-height: 1.6;
    max-width: 480px;
  }

  .categoria-count {
    font-family: monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    opacity: 0.7;
  }

  .categoria-divider {
    margin: 0 48px;
    height: 1px;
    background: linear-gradient(
      to right,
      var(--color-star),
      var(--color-accent),
      transparent
    );
    opacity: 0.35;
  }

  /* ── Section label ─────────────────────────────────────────── */
  .section-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-star);
    margin-bottom: 20px;
  }

  .section-label svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ── Shared card styles ────────────────────────────────────── */
  .card-tag {
    display: inline-block;
    font-family: monospace;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: monospace;
    font-size: 0.62rem;
    color: var(--color-star);
    opacity: 0.55;
  }

  /* ── Destaques / Carousel ──────────────────────────────────── */
  .destaques-section {
    padding: 36px 48px 0;
  }

  .carousel-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .carousel-viewport {
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  .carousel-viewport::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--color-star) 35%,
      var(--color-star) 65%,
      transparent 100%
    );
    box-shadow: 0 0 10px var(--color-star-70), 0 0 24px var(--color-star-40);
    pointer-events: none;
    opacity: 0;
    z-index: 2;
  }

  .carousel-viewport.scanning-next::after {
    animation: scan-next 0.45s ease-in-out forwards;
  }

  .carousel-viewport.scanning-prev::after {
    animation: scan-prev 0.45s ease-in-out forwards;
  }

  @keyframes scan-next {
    0%   { left: 0%;    opacity: 1; }
    80%  { opacity: 0.5; }
    100% { left: 100%;  opacity: 0; }
  }

  @keyframes scan-prev {
    0%   { left: 100%;  opacity: 1; }
    80%  { opacity: 0.5; }
    100% { left: 0%;    opacity: 0; }
  }

  .carousel-track {
    display: flex;
    gap: 16px;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .feat-card {
    flex: 0 0 calc(25% - 12px);
    min-width: 0;
    height: 160px;
    background: transparent;
    border: 1px solid var(--color-star);
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    display: block;
    transition: border-color 0.22s ease;
  }

  .feat-card:hover,
  .feat-card:focus-visible {
    border-color: var(--color-accent);
    outline: none;
  }

  .feat-card:focus-visible {
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .feat-card-body {
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    min-height: 0;
    box-sizing: border-box;
    justify-content: flex-end;
    overflow: hidden;
  }

  .feat-card-title {
    margin: 0;
    font-family: monospace;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-text);
    letter-spacing: 0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .carousel-btn {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-star);
    cursor: pointer;
    transition: color 0.2s ease, filter 0.2s ease;
  }

  .carousel-btn:hover,
  .carousel-btn:focus-visible {
    color: var(--color-accent);
    filter: drop-shadow(0 0 6px var(--color-accent));
    outline: none;
  }

  .carousel-btn:focus-visible {
    border-radius: 4px;
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
    margin-bottom: 4px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-star);
    opacity: 0.35;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.22s ease, transform 0.22s ease, box-shadow 0.22s ease;
  }

  .dot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    opacity: 1;
  }

  .dot.active {
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
    opacity: 1;
    transform: scale(1.25);
  }

  /* ── Posts Grid ────────────────────────────────────────────── */
  .posts-section {
    padding: 40px 48px 48px;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 260px;
    gap: 20px;
  }

  .post-card {
    background: transparent;
    border: 1px solid var(--color-star);
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    display: block;
    height: 100%;
    overflow: hidden;
    transition: border-color 0.22s ease;
  }

  .post-card:hover,
  .post-card:focus-visible {
    border-color: var(--color-accent);
    outline: none;
  }

  .post-card:focus-visible {
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .post-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
