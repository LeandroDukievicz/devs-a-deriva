---
import CommentForm from './comments/CommentForm.astro';
import CommentAuth from './comments/CommentAuth.astro';
import CommentList from './comments/CommentList.astro';

interface Props {
  postSlug: string;
}
const { postSlug } = Astro.props;
const dashboardUrl = import.meta.env.PUBLIC_DASHBOARD_URL ?? 'http://localhost:3000';
---

<section
  class="comments-section"
  id="comments"
  data-slug={postSlug}
  data-dashboard={dashboardUrl}
>
  <div class="comments-header">
    <span class="comments-kicker">&gt;_ comentários</span>
    <span class="comments-count" id="comments-count">0</span>
  </div>

  <!-- Feedback: comentário enviado com sucesso (volta do OAuth) -->
  <div class="comments-success" id="comments-success" hidden>
    <span class="comments-success-dot" aria-hidden="true"></span>
    <p>&gt; comentário recebido. ele aparecerá após moderação.</p>
  </div>

  <!-- Formulário sempre visível -->
  <div class="comments-compose">
    <CommentForm />
    <CommentAuth />
  </div>

  <!-- Lista de comentários (preenchida via JS) -->
  <CommentList />
</section>

<style>
  .comments-section {
    margin-top: 64px;
    animation: fade-up 0.55s ease 0.38s both;
  }

  .comments-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-star-16);
  }

  .comments-kicker {
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .comments-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    border: 1px solid var(--color-accent-40);
    background: var(--color-accent-06);
    font-family: monospace;
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.06em;
  }

  /* Success banner */
  .comments-success {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border: 1px solid var(--color-star-22);
    border-radius: 10px;
    background: var(--color-star-05);
    margin-bottom: 20px;
    animation: fade-up 0.3s ease both;
  }

  .comments-success p {
    margin: 0;
    font-family: monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-star);
  }

  .comments-success-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-star);
    box-shadow: 0 0 10px var(--color-star);
    flex-shrink: 0;
    animation: pulse 1.8s ease infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  .comments-compose {
    margin-bottom: 32px;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .comments-section,
    .comments-success,
    .comments-success-dot {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  import { sanitizeImageUrl, initials } from '../lib/utils/string';
  import { ALLOWED_PROVIDERS, providerIconSvg } from '../lib/comments';

  const section      = document.getElementById('comments') as HTMLElement;
  const slug         = section?.dataset.slug ?? '';
  const dashboardUrl = section?.dataset.dashboard ?? '';

  const textarea     = document.getElementById('comments-textarea') as HTMLTextAreaElement | null;
  const charCount    = document.getElementById('comments-char-count');
  const btnComentar  = document.getElementById('btn-comentar') as HTMLButtonElement | null;
  const btnCancel    = document.getElementById('btn-auth-cancel');
  const authError    = document.getElementById('auth-error');
  const honeypot     = document.getElementById('comments-website') as HTMLInputElement | null;
  const commentsMountedAt = Date.now();
  let firstTypedAt: number | null = null;
  let replyParentId: number | null = null;
  const composeWrite  = document.getElementById('compose-write');
  const composeAuth   = document.getElementById('compose-auth-prompt');
  const successBanner = document.getElementById('comments-success');
  const listEl        = document.getElementById('comments-list');
  const emptyEl       = document.getElementById('comments-empty');
  const loadingEl     = document.getElementById('comments-loading');
  const countEl       = document.getElementById('comments-count');

  // ── Helpers ────────────────────────────────────────────────────
  const setState = (s: 'writing' | 'auth-prompt') => {
    if (!composeWrite || !composeAuth) return;
    composeWrite.hidden = s === 'auth-prompt';
    composeAuth.hidden  = s === 'writing';
    if (authError) authError.textContent = '';

    if (s === 'auth-prompt') {
      const firstSocialBtn = composeAuth.querySelector<HTMLButtonElement>('.social-btn');
      firstSocialBtn?.focus();
    }
  };

  // ── Keyboard events ────────────────────────────────────────────
  const getAuthControls = () => Array.from(
    composeAuth?.querySelectorAll<HTMLButtonElement>('button:not(:disabled)') ?? []
  );

  const focusAuthControl = (current: HTMLButtonElement, direction: 'next' | 'prev' | 'first' | 'last') => {
    const controls = getAuthControls();
    if (!controls.length) return;

    const index = Math.max(0, controls.indexOf(current));
    const targetIndex =
      direction === 'first' ? 0 :
      direction === 'last'  ? controls.length - 1 :
      direction === 'next'  ? (index + 1) % controls.length :
      (index - 1 + controls.length) % controls.length;

    controls[targetIndex]?.focus();
  };

  textarea?.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      btnComentar?.click();
    }
  });

  composeAuth?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      btnCancel?.click();
      return;
    }

    const target = e.target as HTMLButtonElement | null;
    if (!target?.matches('button')) return;

    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      e.preventDefault();
      focusAuthControl(target, 'next');
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      e.preventDefault();
      focusAuthControl(target, 'prev');
    } else if (e.key === 'Home') {
      e.preventDefault();
      focusAuthControl(target, 'first');
    } else if (e.key === 'End') {
      e.preventDefault();
      focusAuthControl(target, 'last');
    }
  });

  const updateCharCount = () => {
    if (textarea && charCount) charCount.textContent = `${textarea.value.length} / 1000`;
  };

  const startReply = (authorName: string, parentId: number) => {
    if (!textarea) return;

    replyParentId = parentId;
    const mention = `@${authorName.replace(/^@+/, '')}`;
    setState('writing');
    textarea.placeholder = `> respondendo ${mention}...`;

    if (!textarea.value.trim()) {
      textarea.value = `${mention} `;
      updateCharCount();
    }

    textarea.focus();
    textarea.setSelectionRange(textarea.value.length, textarea.value.length);
    const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    textarea.scrollIntoView({ behavior, block: 'center' });
  };

  // ── Carregar comentários aprovados ─────────────────────────────
  type CommentData = { id: number; parentId: number | null; authorName: string; authorImage: string | null; provider: string | null; body: string; createdAt: string };

  function buildCommentEl(c: CommentData, isReply: boolean): HTMLLIElement {
    const li = document.createElement('li');
    li.className = isReply ? 'comment-item comment-item--reply' : 'comment-item';

    const avatar = document.createElement('div');
    avatar.className = 'comment-avatar';
    avatar.setAttribute('aria-hidden', 'true');
    const safeImg = sanitizeImageUrl(c.authorImage);
    if (safeImg) {
      const img = document.createElement('img');
      img.src = safeImg;
      img.alt = c.authorName ?? '';
      img.loading = 'lazy';
      avatar.appendChild(img);
    } else {
      avatar.textContent = initials(c.authorName ?? 'A');
    }

    const body = document.createElement('div');
    body.className = 'comment-body';

    const meta = document.createElement('div');
    meta.className = 'comment-meta';

    const nameSpan = document.createElement('span');
    nameSpan.className = 'comment-name';
    nameSpan.textContent = '@' + (c.authorName ?? 'anônimo');
    meta.appendChild(nameSpan);

    // Provider — apenas providers da allowlist recebem ícone; innerHTML aqui é estático
    const provider = c.provider && ALLOWED_PROVIDERS.has(c.provider) ? c.provider : null;
    if (provider) {
      const providerSpan = document.createElement('span');
      providerSpan.className = 'comment-provider';
      providerSpan.title = provider;
      providerSpan.innerHTML = providerIconSvg(provider);
      meta.appendChild(providerSpan);
    }

    body.appendChild(meta);

    const textP = document.createElement('p');
    textP.className = 'comment-text';
    textP.textContent = c.body;
    body.appendChild(textP);

    // Só comentários raiz têm botão Responder (threading 1 nível)
    if (!isReply) {
      const actions = document.createElement('div');
      actions.className = 'comment-actions';

      const replyButton = document.createElement('button');
      replyButton.className = 'comment-reply-btn';
      replyButton.type = 'button';
      replyButton.setAttribute('aria-label', `Responder comentário de ${c.authorName ?? 'anônimo'}`);
      replyButton.innerHTML = `
        <span>Responder</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 17 4 12 9 7"></polyline>
          <path d="M20 18v-2a4 4 0 0 0-4-4H4"></path>
        </svg>
      `;
      replyButton.addEventListener('click', () => startReply(c.authorName ?? 'anônimo', c.id));

      actions.appendChild(replyButton);
      body.appendChild(actions);
    }

    li.appendChild(avatar);
    li.appendChild(body);
    return li;
  }

  const loadComments = async () => {
    try {
      const res = await fetch(`${dashboardUrl}/api/comments?slug=${encodeURIComponent(slug)}`, { cache: 'no-store' });
      const json = await res.json();
      const comments: CommentData[] = json?.data?.comments ?? [];

      if (loadingEl) loadingEl.hidden = true;

      if (!comments.length) {
        if (emptyEl) emptyEl.hidden = false;
        return;
      }

      if (countEl) countEl.textContent = String(comments.length);
      if (listEl)  listEl.hidden = false;

      const topLevel = comments.filter(c => !c.parentId);
      const repliesMap = new Map<number, CommentData[]>();
      for (const c of comments) {
        if (c.parentId) {
          const arr = repliesMap.get(c.parentId) ?? [];
          arr.push(c);
          repliesMap.set(c.parentId, arr);
        }
      }

      for (const c of topLevel) {
        listEl?.appendChild(buildCommentEl(c, false));

        const replies = repliesMap.get(c.id) ?? [];
        for (const r of replies) {
          listEl?.appendChild(buildCommentEl(r, true));
        }
      }
    } catch {
      if (loadingEl) loadingEl.hidden = true;
      if (emptyEl)   emptyEl.hidden = false;
    }
  };

  // ── Verificar retorno do OAuth ─────────────────────────────────
  const params = new URLSearchParams(window.location.search);
  if (params.get('commented') === 'true') {
    if (successBanner) successBanner.hidden = false;
    params.delete('commented');
    const clean = [window.location.pathname, params.toString()].filter(Boolean).join('?');
    window.history.replaceState({}, '', clean);
  }

  // ── Eventos ────────────────────────────────────────────────────
  textarea?.addEventListener('input', () => {
    if (firstTypedAt === null) firstTypedAt = Date.now();
    updateCharCount();
  });

  btnComentar?.addEventListener('click', () => {
    if (!textarea?.value.trim()) { textarea?.focus(); return; }
    setState('auth-prompt');
  });

  btnCancel?.addEventListener('click', () => {
    replyParentId = null;
    setState('writing');
    textarea?.focus();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-provider]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const provider = btn.dataset.provider!;
      const text = textarea?.value.trim();
      if (!text) return;

      document.querySelectorAll<HTMLButtonElement>('[data-provider], #btn-auth-cancel').forEach(b => {
        b.disabled = true;
      });
      if (authError) authError.textContent = '';

      try {
        const res = await fetch(`${dashboardUrl}/api/comments/draft`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slug,
            text,
            provider,
            redirectTo: window.location.href,
            parentId: replyParentId,
            website: honeypot?.value ?? '',
            elapsedMs: Date.now() - commentsMountedAt,
            typingElapsedMs: firstTypedAt !== null ? firstTypedAt - commentsMountedAt : null,
            pageUrl: window.location.href,
          }),
        });

        if (!res.ok) throw new Error('Erro ao registrar comentário');

        const draftJson = await res.json();
        const signInUrl = draftJson?.data?.signInUrl as string | undefined;
        if (!signInUrl) throw new Error('URL de login não retornada');

        replyParentId = null;
        if (textarea) textarea.placeholder = '';
        window.location.href = signInUrl;
      } catch {
        if (authError) authError.textContent = '> erro ao conectar com o servidor. tente novamente.';
        document.querySelectorAll<HTMLButtonElement>('[data-provider], #btn-auth-cancel').forEach(b => {
          b.disabled = false;
        });
      }
    });
  });

  // ── Init ───────────────────────────────────────────────────────
  loadComments();
</script>
