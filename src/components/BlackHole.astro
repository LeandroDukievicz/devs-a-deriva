---
interface Props {
  /** Posição X do buraco negro como fração da largura da tela (0–1). Padrão: 0.94 */
  bhX?: number;
  /** Posição Y do buraco negro como fração da altura da tela (0–1). Padrão: 0.08 */
  bhY?: number;
  /** Multiplicador de tamanho do buraco negro. Padrão: 1.0 */
  bhScale?: number;
}

const { bhX = 0.94, bhY = 0.08, bhScale = 1.0 } = Astro.props;

---

<div
  id="bh-container"
  class="relative w-full h-screen overflow-hidden"
  style="background:var(--color-bg);"
  data-bh-x={bhX}
  data-bh-y={bhY}
  data-bh-scale={bhScale}
>
  <canvas id="c" class="block w-full h-full" aria-hidden="true"></canvas>
</div>

<script>
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const COLOR_BG = getComputedStyle(document.documentElement)
  .getPropertyValue('--color-bg').trim() || '#020b18';

const canvas = document.getElementById('c') as HTMLCanvasElement;
const ctx = canvas.getContext('2d')!;

let W: number, H: number, BH: { x: number; y: number }, RAF = 0;
let running = false;

const CFG = {
  bhRadius: 0,
  diskTilt: -0.22,
  lineCount: 320,
  particleCount: 38,
  speed: 0.0012,
  trailLen: 420,
  ringWidth: 0,
};

let lines: any[] = [];
let particles: any[] = [];
let t = 0;

function resize() {
  W = canvas.width = window.innerWidth;
  H = canvas.height = window.innerHeight;
  const container = document.getElementById('bh-container') as HTMLElement;
  const fracX = parseFloat(container?.dataset.bhX ?? '0.94');
  const fracY = parseFloat(container?.dataset.bhY ?? '0.08');
  const scale = parseFloat(container?.dataset.bhScale ?? '1.0');
  CFG.bhRadius = Math.min(W, H) * 0.22 * scale;
  CFG.ringWidth = Math.min(W, H) * 0.012 * scale;
  BH = { x: W * fracX, y: H * fracY };
  init();
}

function bhDist(x: number, y: number) {
  return Math.sqrt((x - BH.x) ** 2 + (y - BH.y) ** 2);
}

function field(x: number, y: number, time: number) {
  const dx = x - BH.x;
  const dy = y - BH.y;
  const r = Math.sqrt(dx * dx + dy * dy);
  if (r < 2) return { vx: 0, vy: 0 };

  const strength = CFG.bhRadius * CFG.bhRadius / (r * r + 0.01);
  const orb = strength * 1.4;
  const vxOrb = dy / r * orb;
  const vyOrb = -dx / r * orb;

  const diskNx = Math.cos(CFG.diskTilt + Math.PI / 2);
  const diskNy = Math.sin(CFG.diskTilt + Math.PI / 2);
  const perp = dx * diskNx + dy * diskNy;
  const infallScale = Math.exp(-perp * perp / (CFG.bhRadius * CFG.bhRadius * 0.25));
  const infall = -strength * 0.8 * infallScale;
  const vxInfall = dx / r * infall;
  const vyInfall = dy / r * infall;

  const wave = Math.sin(r * 0.012 - time * 2.8) * 0.12 * infallScale;
  const waveX = -dy / r * wave;
  const waveY = dx / r * wave;

  return {
    vx: vxOrb + vxInfall + waveX,
    vy: vyOrb + vyInfall + waveY,
  };
}

function spawnLine(index: number) {
  const frac = index / CFG.lineCount;
  const spread = CFG.bhRadius * 3.2;
  const diskDx = Math.cos(CFG.diskTilt);
  const diskDy = Math.sin(CFG.diskTilt);
  const perpDx = -diskDy;
  const perpDy = diskDx;
  const along = (frac - 0.5) * spread * 2.6;
  const perp = (Math.random() - 0.5) * CFG.bhRadius * 0.55;
  const startR = CFG.bhRadius * (1.1 + Math.random() * 2.8);
  const x0 = BH.x + diskDx * along - diskDx * startR * 0.5 + perpDx * perp;
  const y0 = BH.y + diskDy * along - diskDy * startR * 0.5 + perpDy * perp;

  return {
    x: x0,
    y: y0,
    history: [] as { x: number; y: number }[],
    age: 0,
    maxAge: CFG.trailLen + Math.floor(Math.random() * 324),
    phase: Math.random() * Math.PI * 2,
    weight: 0.4 + Math.random() * 0.9,
    opacity: 0.35 + Math.random() * 0.55,
    alive: true,
  };
}

function spawnParticle() {
  const angle = Math.random() * Math.PI * 2;
  const r = CFG.bhRadius * (0.8 + Math.random() * 2.5);
  return {
    x: BH.x + Math.cos(angle) * r,
    y: BH.y + Math.sin(angle) * r,
    r: 1.5 + Math.random() * 3.5,
    opacity: 0.5 + Math.random() * 0.5,
    alive: true,
    age: 0,
    maxAge: 80 + Math.random() * 200,
  };
}

function init() {
  lines = [];
  particles = [];
  for (let i = 0; i < CFG.lineCount; i++) {
    const line = spawnLine(i);
    line.age = Math.floor(Math.random() * line.maxAge);
    lines.push(line);
  }
  for (let i = 0; i < CFG.particleCount; i++) {
    const particle = spawnParticle();
    particle.age = Math.floor(Math.random() * particle.maxAge);
    particles.push(particle);
  }
}

function update() {
  t += CFG.speed;

  for (const line of lines) {
    if (!line.alive) continue;
    line.age++;
    const { vx, vy } = field(line.x, line.y, t + line.phase);
    line.history.push({ x: line.x, y: line.y });
    if (line.history.length > 60) line.history.shift();
    line.x += vx;
    line.y += vy;

    const dist = bhDist(line.x, line.y);
    const outOfBounds = line.x < -50 || line.x > W + 50 || line.y < -50 || line.y > H + 50;
    if (dist < CFG.bhRadius * 0.98 || outOfBounds || line.age > line.maxAge) {
      line.alive = false;
    }
  }

  for (let i = 0; i < lines.length; i++) {
    if (!lines[i].alive) lines[i] = spawnLine(i);
  }

  for (const particle of particles) {
    if (!particle.alive) continue;
    particle.age++;
    const { vx, vy } = field(particle.x, particle.y, t);
    particle.x += vx * 0.6;
    particle.y += vy * 0.6;
    const dist = bhDist(particle.x, particle.y);
    if (dist < CFG.bhRadius * 0.84 || particle.age > particle.maxAge) particle.alive = false;
  }
  for (let i = 0; i < particles.length; i++) {
    if (!particles[i].alive) particles[i] = spawnParticle();
  }
}

function draw() {
  ctx.fillStyle = (window as any).__bgColor ?? COLOR_BG;
  ctx.fillRect(0, 0, W, H);

  ctx.save();
  ctx.beginPath();
  ctx.rect(0, 0, W, H);
  ctx.arc(BH.x, BH.y, CFG.bhRadius * 0.99, 0, Math.PI * 2, true);
  ctx.clip('evenodd');

  for (const line of lines) {
    if (!line.alive || line.history.length < 2) continue;
    const history = line.history;
    ctx.beginPath();
    ctx.moveTo(history[0].x, history[0].y);
    for (let i = 1; i < history.length; i++) ctx.lineTo(history[i].x, history[i].y);
    ctx.lineTo(line.x, line.y);

    const distHead = bhDist(line.x, line.y);
    const proximity = Math.max(0, Math.min(1, 1 - (distHead - CFG.bhRadius) / (CFG.bhRadius * 1.5)));
    const alpha = line.opacity * (0.5 + proximity * 0.5);
    ctx.strokeStyle = `rgba(0,${Math.round(190 + proximity * 55)},${Math.round(210 + proximity * 40)},${alpha})`;
    ctx.lineWidth = line.weight * (0.7 + proximity * 0.6);
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.stroke();
  }

  for (const particle of particles) {
    if (!particle.alive) continue;
    const dist = bhDist(particle.x, particle.y);
    const fade = Math.min(1, (dist - CFG.bhRadius * 0.9) / (CFG.bhRadius * 0.3));
    ctx.beginPath();
    ctx.arc(particle.x, particle.y, particle.r, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(0,210,240,${particle.opacity * fade})`;
    ctx.fill();
  }

  ctx.restore();
}

function loop() {
  if (document.visibilityState === 'hidden') {
    running = false;
    return;
  }
  update();
  draw();
  RAF = requestAnimationFrame(loop);
}

function startLoop() {
  if (reduceMotion || running || document.visibilityState === 'hidden') return;
  running = true;
  RAF = requestAnimationFrame(loop);
}

function stopLoop() {
  if (!running) return;
  cancelAnimationFrame(RAF);
  running = false;
}

resize();
draw();
startLoop();

window.addEventListener('resize', () => {
  stopLoop();
  resize();
  draw();
  startLoop();
});

document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'hidden') stopLoop();
  else startLoop();
});
</script>
