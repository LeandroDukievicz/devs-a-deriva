---
import type { Author } from '../types/blog';

interface Props {
  slug: string;
  sectionId: string;
  href: string;
  title: string;
  category: string;
  excerpt: string;
  imageSrc: string;
  author: Author;
  authorBio: string;
}

const { slug, sectionId, href, title, category, excerpt, imageSrc, author, authorBio } = Astro.props;
---

<div class="content-section" data-section-id={sectionId} data-post-slug={slug} data-post-href={href} role="link" tabindex="0">
  <div class="section-image">
    <img src={imageSrc} alt={category} class="section-img" width="400" height="266" loading="lazy" decoding="async" />
  </div>
  <div class="section-body">
    <div class="section-info">
      <h2><a href={href} class="title-link">{title}</a></h2>

      <div class="post-meta">
        <img
          class="post-author-photo"
          src={author.photo}
          alt={`Foto de ${author.name}`}
          width="46"
          height="46"
          loading="lazy"
          decoding="async"
        />
        <div class="post-author-copy">
          <span class="post-author-name">{author.name}</span>
          <span class="post-author-bio">{authorBio}</span>
        </div>
      </div>

      <div class="post-topic-row">
        <span class="post-topic"><span class="post-topic-label">Tema</span>: {category}</span>
        <div class="reading-progress">
          <svg class="progress-ring" width="20" height="20" viewBox="0 0 20 20">
            <circle class="progress-ring-bg" cx="10" cy="10" r="7" fill="none" stroke-width="2"/>
            <circle class="progress-ring-fill" cx="10" cy="10" r="7" fill="none" stroke-width="2" stroke-linecap="round" stroke-dasharray="43.98" stroke-dashoffset="43.98"/>
          </svg>
          <span class="progress-text">0% lido</span>
        </div>
      </div>

    </div>

    <div class="section-text">
      <a href={href} class="limbo-cta">Lançar ao limbo</a>
      <p>{excerpt}</p>
      <a href={href} class="cta-read">Continuar leitura <span class="dot" style="animation-delay:0s">.</span><span class="dot" style="animation-delay:0.2s">.</span><span class="dot" style="animation-delay:0.4s">.</span></a>
    </div>
  </div>
</div>

<style>
  .content-section {
    position: relative;
    display: flex;
    flex-direction: row;
    min-height: 75px;
    box-sizing: border-box;
    border: 1px outset var(--color-star);
    border-radius: 8px;
    overflow: hidden;
    background: transparent;
    transition: border-color 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease;
  }

  .content-section:hover {
    border-color: var(--color-accent);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.24);
    transform: translateY(-2px);
  }

  .content-section[role="link"] {
    cursor: pointer;
  }

  .content-section[role="link"]:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-16), 0 14px 30px rgba(0, 0, 0, 0.24);
  }

  .content-section:hover .limbo-cta {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .content-section.is-vanishing {
    pointer-events: none;
  }

  .content-section h2 {
    margin: 0 0 8px;
    font-size: 1rem;
    font-weight: 600;
    font-family: monospace;
  }

  .content-section p {
    margin: 0 0 10px;
    font-size: 0.82rem;
    color: #a0c4cc;
    font-family: monospace;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .section-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    display: block;
    transition: transform 0.4s ease;
  }

  .section-image:hover {
    cursor: pointer;
  }

  .section-image:hover .section-img {
    transform: scale(1.04);
  }

  .section-image {
    flex: 0 0 31.68%;
    min-height: 126px;
    margin: 15px;
    padding: 5px;
    border-radius: 6px;
    background: transparent;
    box-shadow: 0 6px 20px 4px rgba(0, 0, 0, 0.45);
    box-sizing: border-box;
    overflow: hidden;
  }

  .section-body {
    flex: 1;
    display: flex;
    flex-direction: row;
    min-width: 0;
  }

  .section-info {
    flex: 1;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .section-text {
    flex: 0 0 50%;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .title-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .title-link:hover {
    color: var(--color-accent);
  }

  .limbo-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-end;
    margin: -8px -4px 10px 0;
    padding: 0;
    color: var(--color-star);
    opacity: 0;
    visibility: hidden;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.601rem;
    font-family: monospace;
    transform: translateY(-4px);
    transition: color 0.3s ease, transform 0.35s ease, opacity 0.35s ease;
  }

  .limbo-cta:hover {
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .cta-read {
    margin-top: auto;
    align-self: flex-end;
    font-size: 0.72rem;
    font-family: monospace;
    color: var(--color-star);
    text-decoration: none;
    padding: 5px 0;
    transition: color 0.2s;
  }

  .cta-read:hover {
    color: var(--color-accent);
  }

  .dot {
    display: inline-block;
    animation: wave-dot 1.2s ease-in-out infinite;
  }

  @keyframes wave-dot {
    0%, 100% { transform: translateY(0);    opacity: 1;   }
    50%       { transform: translateY(-4px); opacity: 0.4; }
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    min-width: 0;
  }

  .post-author-photo {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-star-25);
    box-shadow: 0 0 16px var(--color-star-10);
    flex-shrink: 0;
  }

  .post-author-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .post-author-name {
    font-size: 0.72rem;
    color: var(--color-star);
    font-family: monospace;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .post-author-bio {
    font-size: 0.63rem;
    color: #5a8a94;
    font-family: monospace;
    line-height: 1.45;
  }

  .post-topic-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .post-topic {
    display: block;
    font-size: 0.72rem;
    color: var(--color-star);
    font-family: monospace;
  }

  .post-topic-label {
    color: inherit;
  }

  .reading-progress {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .progress-ring {
    transform: rotate(-90deg);
    flex-shrink: 0;
  }

  .progress-ring-bg {
    stroke: var(--color-star-18);
  }

  .progress-ring-fill {
    stroke: var(--color-star);
    transition: stroke-dashoffset 0.5s ease, stroke 0.5s ease;
  }

  .progress-ring-fill.completed {
    stroke: var(--color-star);
  }

  .progress-text {
    font-size: 0.65rem;
    font-family: monospace;
    color: var(--color-accent);
    transition: color 0.5s ease;
  }

  .progress-text.completed {
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .content-section {
      min-height: 0;
    }

    .section-body {
      flex-direction: column;
    }

    .section-image {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .content-section {
      border-radius: 10px;
    }

    .section-image {
      display: block;
      min-height: 160px;
      margin: 12px 12px 0;
    }

    .section-info,
    .section-text {
      padding: 16px;
    }

    .limbo-cta {
      margin: -4px -2px 10px 0;
    }

    .content-section h2 {
      font-size: 0.95rem;
    }

    .content-section p {
      font-size: 0.78rem;
    }

    .post-author-photo {
      width: 40px;
      height: 40px;
    }

    .post-author-bio {
      font-size: 0.6rem;
    }

    .post-topic {
      font-size: 0.68rem;
    }

    .cta-read {
      align-self: flex-start;
      margin-top: 16px;
    }
  }

  @media (max-width: 480px) {
    .section-image {
      min-height: 128px;
    }

    .section-info,
    .section-text {
      padding: 14px;
    }

    .limbo-cta {
      margin-top: 0;
      margin-right: 0;
      align-self: flex-end;
    }

    .post-topic-row {
      flex-wrap: wrap;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .content-section,
    .content-section *,
    .cta-read,
    .limbo-cta,
    .dot,
    .progress-ring-fill,
    .progress-text {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
