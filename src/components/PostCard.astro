---
import type { Author } from '../types/blog';
import SocialIcon from './SocialIcon.astro';

interface Props {
  slug: string;
  sectionId: string;
  href: string;
  title: string;
  category: string;
  excerpt: string;
  imageSrc: string;
  author: Author;
  authorBio: string;
}

const { slug, sectionId, href, title, category, excerpt, imageSrc, author, authorBio } = Astro.props;
---

<div class="content-section" data-section-id={sectionId} data-post-slug={slug} data-post-href={href} role="link" tabindex="0">
  <div class="section-image">
    <img src={imageSrc} alt={category} class="section-img" />
  </div>
  <div class="section-body">
    <div class="section-info">
      <h2><a href={href} class="title-link">{title}</a></h2>

      <div class="post-meta">
        <img
          class="post-author-photo"
          src={author.photo}
          alt={`Foto de ${author.name}`}
          loading="lazy"
          decoding="async"
        />
        <div class="post-author-copy">
          <span class="post-author-name">{author.name}</span>
          <span class="post-author-bio">{authorBio}</span>
        </div>
      </div>

      <div class="post-topic-row">
        <span class="post-topic">Tema: {category}</span>
        <div class="reading-progress">
          <svg class="progress-ring" width="20" height="20" viewBox="0 0 20 20">
            <circle class="progress-ring-bg" cx="10" cy="10" r="7" fill="none" stroke-width="2"/>
            <circle class="progress-ring-fill" cx="10" cy="10" r="7" fill="none" stroke-width="2" stroke-linecap="round" stroke-dasharray="43.98" stroke-dashoffset="43.98"/>
          </svg>
          <span class="progress-text">0% lido</span>
        </div>
      </div>

      <div class="post-actions">
        {author.socialLinks.linkedin && (
          <SocialIcon network="linkedin" href={author.socialLinks.linkedin} label={`LinkedIn de ${author.name}`} />
        )}
        {author.socialLinks.github && (
          <SocialIcon network="github" href={author.socialLinks.github} label={`GitHub de ${author.name}`} />
        )}
        {author.socialLinks.instagram && (
          <SocialIcon network="instagram" href={author.socialLinks.instagram} label={`Instagram de ${author.name}`} />
        )}
        {author.socialLinks.twitter && (
          <SocialIcon network="twitter" href={author.socialLinks.twitter} label={`X de ${author.name}`} />
        )}
        <button class="cta-btn copy-btn" aria-label="Copiar link do post">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </button>
      </div>
    </div>

    <div class="section-text">
      <a href={href} class="limbo-cta">Lançar ao limbo</a>
      <p>{excerpt}</p>
      <a href={href} class="cta-read">Continuar leitura <span class="dot" style="animation-delay:0s">.</span><span class="dot" style="animation-delay:0.2s">.</span><span class="dot" style="animation-delay:0.4s">.</span></a>
    </div>
  </div>
</div>
