---
import type { Author } from '../types/blog';
import { formatDate } from '../lib/posts';

interface Props {
  slug: string;
  sectionId: string;
  href: string;
  title: string;
  category: string;
  excerpt: string;
  imageSrc: string;
  author: Author;
  authorBio: string;
  publishedAt?: string | null;
}
const { slug, sectionId, href, title, category, excerpt, imageSrc, author, publishedAt } = Astro.props;
---

<article class="content-section" data-section-id={sectionId} data-post-slug={slug}>
  <a href={href} class="post-card-link">
    <div class="section-image">
      <img src={imageSrc} alt="" class="section-img" width="640" height="400" loading="lazy" decoding="async" />
    </div>
    <div class="section-content">
      <span class="category-badge">{category}</span>
      <h3>{title}</h3>
      <p class="post-excerpt">{excerpt}</p>
      <div class="card-footer">
        <img class="post-author-photo" src={author.photo} alt="" width="38" height="38" loading="lazy" decoding="async" />
        <div class="post-author-copy">
          <span class="post-author-name">{author.name}</span>
          {publishedAt && <time datetime={publishedAt}>{formatDate(publishedAt)}</time>}
        </div>
        <span class="reading-progress" data-progress-label>0% lido</span>
      </div>
    </div>
  </a>
  <button class="limbo-cta" type="button" aria-label={`Lançar ao limbo: ${title}`}>Lançar ao limbo</button>
</article>

<style>
  .content-section {
    position: relative;
    min-width: 0;
    border: 1px solid var(--color-star-25);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-bg-88);
    transition: border-color .25s, box-shadow .25s;
  }
  .content-section:hover,
  .content-section:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 24px var(--color-accent-08);
  }
  .post-card-link { display: flex; flex-direction: column; height: 100%; color: var(--color-text); text-decoration: none; }
  .post-card-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -4px; }
  .section-image { aspect-ratio: 16 / 10; overflow: hidden; background: var(--color-star-05); }
  .section-img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .post-card-link:hover .section-img { transform: scale(1.035); }
  .section-content { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; flex: 1; min-height: 290px; padding: 24px; box-sizing: border-box; }
  .category-badge { color: var(--color-accent); font: .65rem/1.4 monospace; text-transform: uppercase; letter-spacing: .08em; }
  h3 { margin: 0; font: 600 clamp(1.05rem, 1.5vw, 1.3rem)/1.4 monospace; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
  .post-excerpt { margin: 0; color: var(--color-reading-text); opacity: .8; font: .82rem/1.75 monospace; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .card-footer { display: flex; align-items: center; gap: 10px; width: 100%; margin-top: auto; padding-top: 20px; }
  .post-author-photo { width: 38px; height: 38px; object-fit: cover; border: 1px solid var(--color-star-25); border-radius: 50%; flex-shrink: 0; }
  .post-author-copy { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .post-author-name { color: var(--color-star); font: .7rem/1.4 monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  time { color: var(--color-reading-text); opacity: .7; font: .65rem/1.4 monospace; }
  .reading-progress { margin-left: auto; flex-shrink: 0; color: var(--color-star); font: .58rem/1.4 monospace; opacity: .65; }
  .reading-progress.completed { color: var(--color-accent); opacity: 1; }
  .limbo-cta { position: absolute; top: 12px; right: 12px; padding: 7px 10px; color: var(--color-star); background: var(--color-bg-90); border: 1px solid var(--color-star-25); border-radius: 4px; font: .58rem/1.4 monospace; text-transform: uppercase; cursor: pointer; opacity: 0; transition: opacity .2s; }
  .content-section:hover .limbo-cta, .content-section:focus-within .limbo-cta { opacity: 1; }
  .limbo-cta:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .is-vanishing { pointer-events: none; }
  @media (hover: none) { .limbo-cta { opacity: 1; } }
  @media (max-width: 640px) { .section-content { min-height: 270px; padding: 22px; } h3 { font-size: 1.15rem; } }
  @media (prefers-reduced-motion: reduce) { .content-section, .section-img, .limbo-cta { transition: none; } }
</style>
