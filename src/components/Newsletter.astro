---
interface Props {
  dashboardUrl: string;
  postSlug: string;
}
const { dashboardUrl, postSlug } = Astro.props;
---

<div class="newsletter-block" data-dashboard-url={dashboardUrl} data-post-slug={postSlug}>
  <div class="newsletter-content">
    <span class="newsletter-tag">&gt;_ Newsletter</span>
    <h2 class="newsletter-title">E aí, gostou do conteúdo?</h2>
    <p class="newsletter-desc">Se quiser ficar por dentro dos novos posts, opiniões sem filtro e saber o que tá rolando no mundo tech, entra na lista. Sem spam, sem aquela encheção que faz você querer cancelar no segundo e-mail.</p>
  </div>
  <form class="newsletter-form" id="newsletter-form" novalidate>
    <input
      type="text"
      class="newsletter-honeypot"
      id="newsletter-website"
      name="website"
      autocomplete="off"
      tabindex="-1"
      aria-hidden="true"
    />
    <div class="newsletter-input-wrap">
      <input
        type="email"
        class="newsletter-input"
        id="newsletter-email"
        placeholder="seu@email.com"
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        aria-label="Seu e-mail"
        required
      />
      <button type="submit" class="newsletter-btn" aria-label="Entrar na órbita">
        <span class="newsletter-btn-text">Entrar na órbita</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </button>
    </div>
    <label class="newsletter-consent">
      <input type="checkbox" id="newsletter-consent" required />
      <span class="newsletter-check" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </span>
      <span>Autorizo o uso deste e-mail para receber a newsletter e sei que posso solicitar exclusão a qualquer momento.</span>
    </label>
    <p class="newsletter-status" id="newsletter-status" aria-live="polite"></p>
  </form>
  <div class="newsletter-overlay" id="newsletter-overlay" aria-live="polite" aria-hidden="true">
    <span class="newsletter-overlay-grid" aria-hidden="true"></span>
    <div class="newsletter-overlay-badge">
      <span class="newsletter-overlay-badge-dot" aria-hidden="true"></span>
      <span>SINAL RECEBIDO</span>
    </div>
    <div class="newsletter-overlay-copy">
      <span class="newsletter-overlay-kicker">&gt; transmissão confirmada</span>
      <strong>Houston, temos um novo assinante!</strong>
    </div>
  </div>
</div>

<style>
  .newsletter-block {
    margin-top: 72px;
    padding: 40px;
    border: 1px solid var(--color-star-22);
    border-radius: 12px;
    background: linear-gradient(135deg, var(--color-star-05) 0%, transparent 60%);
    display: flex;
    gap: 48px;
    align-items: center;
    animation: fade-up 0.55s ease 0.35s both;
    position: relative;
    overflow: hidden;
    transition: border-color 0.28s ease, box-shadow 0.28s ease, background 0.28s ease;
  }

  .newsletter-block::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 28%, var(--color-accent-12), transparent 32%),
      radial-gradient(circle at 76% 72%, var(--color-star-10), transparent 30%);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .newsletter-block.is-confirmed {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent-12), 0 18px 42px rgba(0, 0, 0, 0.24);
    background: linear-gradient(135deg, var(--color-star-08) 0%, transparent 60%);
  }

  .newsletter-block.is-confirmed::after {
    opacity: 1;
    animation: newsletter-overlay-pulse 2.4s ease both;
  }

  .newsletter-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    position: relative;
    z-index: 1;
    transition: opacity 0.18s ease, visibility 0.18s ease, transform 0.18s ease;
  }

  .newsletter-tag {
    font-family: monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .newsletter-title {
    margin: 0;
    font-family: monospace;
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: var(--color-star);
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .newsletter-desc {
    margin: 0;
    font-family: monospace;
    font-size: 0.72rem;
    line-height: 1.7;
    color: var(--color-star);
    opacity: 0.55;
  }

  .newsletter-form {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    position: relative;
    z-index: 1;
    transition: opacity 0.18s ease, visibility 0.18s ease, transform 0.18s ease;
  }

  .newsletter-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .newsletter-block.is-confirmed .newsletter-content,
  .newsletter-block.is-confirmed .newsletter-form {
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
  }

  .newsletter-input-wrap {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--color-star-40);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .newsletter-input-wrap:focus-within {
    border-color: var(--color-star);
    box-shadow: 0 0 14px var(--color-star-22);
  }

  .newsletter-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    padding: 12px 16px;
    font-family: monospace;
    font-size: 0.78rem;
    color: var(--color-text);
    letter-spacing: 0.04em;
    min-width: 0;
  }

  .newsletter-input::placeholder {
    color: var(--color-star);
    opacity: 0.3;
  }

  .newsletter-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    background: var(--color-star-10);
    border: none;
    border-left: 1px solid var(--color-star-22);
    color: var(--color-star);
    font-family: monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .newsletter-btn:hover { background: var(--color-star-22); color: var(--color-accent); }
  .newsletter-btn:disabled { opacity: 0.55; cursor: not-allowed; }

  .newsletter-consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: monospace;
    font-size: 0.6rem;
    line-height: 1.55;
    letter-spacing: 0.05em;
    color: var(--color-star);
    opacity: 0.5;
    cursor: pointer;
  }

  .newsletter-consent input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .newsletter-check {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-top: 1px;
    border-radius: 4px;
    border: 1px solid var(--color-star-40);
    background: linear-gradient(135deg, var(--color-star-08), transparent), var(--color-star-05);
    color: var(--color-bg);
    box-shadow: inset 0 0 0 1px transparent;
    flex-shrink: 0;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .newsletter-check svg {
    width: 11px;
    height: 11px;
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 0.16s ease, transform 0.16s ease;
  }

  .newsletter-consent:hover .newsletter-check { border-color: var(--color-star); box-shadow: 0 0 12px var(--color-star-18); }

  .newsletter-consent input:focus-visible + .newsletter-check {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .newsletter-consent input:checked + .newsletter-check {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-bg);
    box-shadow: 0 0 16px var(--color-accent-30);
    transform: translateY(-1px);
  }

  .newsletter-consent input:checked + .newsletter-check svg { opacity: 1; transform: scale(1); }

  .newsletter-consent input:not(:checked) + .newsletter-check {
    animation: newsletter-check-pulse 2.6s ease-in-out infinite;
  }

  @keyframes newsletter-check-pulse {
    0%, 100% { box-shadow: inset 0 0 0 1px transparent, 0 0 0 rgba(255, 0, 180, 0); transform: scale(1); }
    48% { box-shadow: inset 0 0 0 1px rgba(255, 0, 180, 0.2), 0 0 14px rgba(255, 0, 180, 0.36); transform: scale(1.05); }
  }

  @media (prefers-reduced-motion: reduce) {
    .newsletter-consent input:not(:checked) + .newsletter-check { animation: none; }
  }

  .newsletter-status {
    margin: 0;
    font-family: monospace;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    min-height: 1em;
    transition: color 0.2s ease;
  }

  .newsletter-status.success { color: var(--color-star); }
  .newsletter-status.error   { color: var(--color-accent); }

  .newsletter-overlay {
    position: absolute;
    inset: 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding: 24px;
    border-radius: 12px;
    background:
      linear-gradient(135deg, rgba(5, 9, 19, 0.96), rgba(7, 13, 26, 0.9)),
      radial-gradient(circle at top left, var(--color-accent-12), transparent 45%);
    border: 1px solid var(--color-accent-12);
    opacity: 0;
    transform: scale(0.98);
    pointer-events: none;
    transition: opacity 0.28s ease, transform 0.34s ease;
    z-index: 3;
    overflow: hidden;
  }

  .newsletter-overlay.is-visible { opacity: 1; transform: scale(1); }

  .newsletter-overlay-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: 0.28;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), transparent);
  }

  .newsletter-overlay-badge,
  .newsletter-overlay-copy { position: relative; z-index: 1; }

  .newsletter-overlay-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    padding: 8px 12px;
    border: 1px solid var(--color-accent-12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    font-family: monospace;
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .newsletter-overlay-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent);
  }

  .newsletter-overlay-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 420px;
  }

  .newsletter-overlay-kicker {
    font-family: monospace;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-star);
    opacity: 0.72;
  }

  .newsletter-overlay strong {
    font-family: monospace;
    font-size: clamp(0.92rem, 2vw, 1.15rem);
    line-height: 1.45;
    letter-spacing: 0.04em;
    color: var(--color-star);
  }

  .newsletter-overlay.is-visible .newsletter-overlay-badge {
    animation: newsletter-overlay-badge-in 0.5s ease-out both;
  }

  .newsletter-overlay.is-visible .newsletter-overlay-copy {
    animation: newsletter-overlay-copy-in 0.58s ease-out 0.08s both;
  }

  @keyframes newsletter-overlay-pulse {
    0% { opacity: 0; }
    18% { opacity: 1; }
    100% { opacity: 0.72; }
  }

  @keyframes newsletter-overlay-badge-in {
    0% { opacity: 0; transform: translateY(-8px) scale(0.94); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes newsletter-overlay-copy-in {
    0% { opacity: 0; transform: translateY(12px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 760px) {
    .newsletter-block { flex-direction: column; gap: 28px; padding: 28px 24px; }
  }
</style>

<script>
  import { validateAndNormalizeEmail } from '../lib/newsletter-email';

  const block = document.querySelector<HTMLElement>('.newsletter-block');
  const dashboardUrl = block?.dataset.dashboardUrl ?? '';
  const postSlug = block?.dataset.postSlug ?? '';

  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const status = document.getElementById('newsletter-status') as HTMLElement | null;
  const input = document.getElementById('newsletter-email') as HTMLInputElement | null;
  const consent = document.getElementById('newsletter-consent') as HTMLInputElement | null;
  const honeypot = document.getElementById('newsletter-website') as HTMLInputElement | null;
  const overlay = document.getElementById('newsletter-overlay') as HTMLElement | null;
  const newsletterEndpoint = dashboardUrl ? `${dashboardUrl}/api/newsletter/subscribe` : '';
  const newsletterMountedAt = Date.now();
  let overlayTimeout: number | undefined;

  const showNewsletterOverlay = () => {
    if (!overlay || !block) return;
    block.classList.remove('is-confirmed');
    overlay.classList.remove('is-visible');
    void overlay.offsetWidth;
    block.classList.add('is-confirmed');
    overlay.classList.add('is-visible');
    overlay.setAttribute('aria-hidden', 'false');
    if (overlayTimeout) window.clearTimeout(overlayTimeout);
    overlayTimeout = window.setTimeout(() => {
      block.classList.remove('is-confirmed');
      overlay.classList.remove('is-visible');
      overlay.setAttribute('aria-hidden', 'true');
    }, 2400);
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!input || !status) return;

    const emailResult = validateAndNormalizeEmail(input.value);
    if (!emailResult.isValid) {
      status.textContent = '> e-mail inválido.';
      status.className = 'newsletter-status error';
      return;
    }

    if (!consent?.checked) {
      status.textContent = '> confirme o recebimento da newsletter.';
      status.className = 'newsletter-status error';
      return;
    }

    if (!newsletterEndpoint) {
      status.textContent = '> captação indisponível no momento.';
      status.className = 'newsletter-status error';
      return;
    }

    const btn = form.querySelector<HTMLButtonElement>('.newsletter-btn');
    if (btn) btn.disabled = true;
    status.textContent = '> enviando...';
    status.className = 'newsletter-status';

    try {
      const response = await fetch(newsletterEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: emailResult.normalizedEmail,
          originalEmail: emailResult.originalEmail,
          source: 'post_newsletter',
          postSlug,
          consent: true,
          consentText: 'Autorizo o uso deste e-mail para receber a newsletter e sei que posso solicitar exclusão a qualquer momento.',
          website: honeypot?.value ?? '',
          elapsedMs: Date.now() - newsletterMountedAt,
          pageUrl: window.location.href,
        }),
      });

      if (!response.ok && response.status >= 500) throw new Error('Newsletter endpoint unavailable');

      input.value = '';
      if (consent) consent.checked = false;
      status.textContent = '> se esse e-mail puder entrar na órbita, você receberá a confirmação.';
      status.className = 'newsletter-status success';
      showNewsletterOverlay();
    } catch {
      status.textContent = '> não foi possível registrar agora. tente novamente.';
      status.className = 'newsletter-status error';
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
