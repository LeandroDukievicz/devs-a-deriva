---
interface Props { slug: string }
const { slug } = Astro.props;
---

<div class="post-pdf-download">
  <a href={`/posts/${slug}/pdf`} class="post-pdf-link" download={`devs-a-deriva-${slug}.pdf`}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 16v4h14v-4" /></svg>
    <span data-pdf-label>Baixar PDF</span>
  </a>
  <span class="post-pdf-status" role="status" aria-live="polite"></span>
</div>

<style>
  .post-pdf-download { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 18px 0; }
  .post-pdf-link { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid var(--color-star-40); border-radius: 6px; color: var(--color-star); background: var(--color-star-05); text-decoration: none; font: .72rem/1.4 monospace; transition: border-color .2s, color .2s; }
  .post-pdf-link:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .post-pdf-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .post-pdf-link[aria-busy='true'] { cursor: progress; opacity: .65; }
  .post-pdf-status { color: var(--color-reading-text); font: .7rem/1.5 monospace; }
</style>

<script>
  const link = document.querySelector<HTMLAnchorElement>('.post-pdf-link');
  const label = document.querySelector<HTMLElement>('[data-pdf-label]');
  const status = document.querySelector<HTMLElement>('.post-pdf-status');
  link?.addEventListener('click', async event => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    if (link.getAttribute('aria-busy') === 'true') return;
    link.setAttribute('aria-busy', 'true');
    if (label) label.textContent = 'Gerando PDF…';
    if (status) status.textContent = '';
    try {
      const response = await fetch(link.href, { signal: AbortSignal.timeout(30_000) });
      if (!response.ok || !response.headers.get('content-type')?.includes('application/pdf')) throw new Error('PDF unavailable');
      const url = URL.createObjectURL(await response.blob());
      const download = document.createElement('a');
      download.href = url;
      download.download = link.download;
      document.body.append(download);
      download.click();
      download.remove();
      setTimeout(() => URL.revokeObjectURL(url), 30_000);
      if (status) status.textContent = 'Download iniciado.';
    } catch {
      if (status) status.textContent = 'Não foi possível baixar o PDF. Tente novamente.';
    } finally {
      link.removeAttribute('aria-busy');
      if (label) label.textContent = 'Baixar PDF';
    }
  });
</script>
