---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import StarBackground from '../../components/StarBackground.astro';
import Comments from '../../components/Comments.astro';
import Newsletter from '../../components/Newsletter.astro';
import { fetchPosts } from '../../lib/posts';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const allPosts = await fetchPosts();
const postIndex = allPosts.findIndex((p) => p.slug === slug);
if (postIndex === -1) return Astro.redirect('/404');

const post = allPosts[postIndex];
const nextPost = allPosts[postIndex + 1] ?? allPosts[0];
const DASHBOARD_URL = import.meta.env.PUBLIC_DASHBOARD_URL ?? 'http://localhost:3000';
const SITE = 'https://devsaderiva.com.br';
const postImages: Record<string, string> = {
  'portas-que-nao-levam-a-lugar-nenhum': '/home-portas-que-nao-levam-a-lugar-nenhum.png',
  'navegando-em-mares-que-inventei': '/home-navegando-em-mares-que-inventei.png',
  'cartas-para-meu-eu-do-futuro': '/home-cartas-para-meu-eu-do-futuro.png',
  'o-estado-atual-da-ia-no-desenvolvimento': '/home-o-estado-atual-da-ia-no-desenvolvimento.png',
  'typescript-strict-mode-vale-a-pena': '/home-typescript-strict-mode-vale-a-pena.png',
};
const categoryImages: Record<string, string> = {
  aleatoriedades: '/aleatoriedades-astronaut-body.webp',
  carreira: '/carreira-profissional-astronaut-body.webp',
  livros: '/livros-astronaut.webp',
  musica: '/musica-astronaut.webp',
  noticias: '/noticias-astronaut.webp',
  tech: '/tech-astronaut.webp',
};
const postHeroImage = post.thumbUrl ?? postImages[post.slug] ?? categoryImages[post.categorySlug] ?? '/logo-high-color.webp';
const postHeroImageAbsolute = postHeroImage.startsWith('http') ? postHeroImage : `${SITE}${postHeroImage}`;
const categoryBackHref = `/categorias/${post.categorySlug}`;
const categoryNextHref = `/posts/${nextPost.slug}?from=category`;
const postAbsoluteUrl = `${SITE}/posts/${post.slug}`;
const geminiSummaryPrompt = `Gere um resumo em português do Brasil, em um parágrafo, para este post: ${postAbsoluteUrl}. Foque no contexto geral e nos principais pontos.`;
const geminiSummaryUrl = `https://gemini.google.com/app?prompt=${encodeURIComponent(geminiSummaryPrompt)}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  image: postHeroImageAbsolute,
  author: {
    '@type': 'Person',
    name: post.author.name,
    ...(post.author.socialLinks.linkedin ? { url: post.author.socialLinks.linkedin } : {}),
  },
  publisher: {
    '@type': 'Organization',
    name: 'Devs à Deriva',
    logo: {
      '@type': 'ImageObject',
      url: `${SITE}/logo-high-color.webp`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${SITE}/posts/${post.slug}`,
  },
  inLanguage: 'pt-BR',
  keywords: post.category,
  ...(post.publishedAt ? { datePublished: post.publishedAt } : {}),
};
---

<Base
  title={`${post.title} · Devs à Deriva`}
  description={post.excerpt}
  ogImage={postHeroImageAbsolute}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>
  <StarBackground />

  <article id="main-content" class="post-page" data-post-slug={post.slug} data-dashboard-url={DASHBOARD_URL}>
    <header class="post-header">
      <div class="post-header-main">
        <div class="post-header-copy">
          <a
            href={categoryBackHref}
            class="post-back"
            data-home-href="/"
            data-home-label="Home"
            data-category-href={categoryBackHref}
            data-category-label={post.category}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
            <span class="post-back-label">{post.category}</span>
          </a>

          <h1 class="post-title">{post.title}</h1>
          <a class="post-tldr-cta" href={geminiSummaryUrl} target="_blank" rel="noopener noreferrer">
            <span>TL;DR</span>
            Clique aqui pra ver o resumo
          </a>
          <div class="post-theme-row" data-home-only="true">
            <p class="post-theme"><span class="post-theme-label">Tema</span>: {post.category}</p>
            <div class="post-reading-time post-reading-time-mobile">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              {post.readTime} de leitura
              <span class="post-reading-progress" data-progress-label>0% lido</span>
            </div>
          </div>

          <div class="post-meta">
            <div class="post-author">
              <img
                class="post-author-avatar"
                src={post.author.photo}
                alt={`Foto de ${post.author.name}`}
                loading="eager"
                decoding="async"
              />
              <div class="post-author-copy">
                <span class="post-author-name">{post.author.name}</span>
                <span class="post-author-role">{post.author.role}</span>
              </div>
            </div>

            <span class="post-meta-separator" aria-hidden="true"></span>

            <div class="post-reading-time">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              {post.readTime} de leitura
              <span class="post-reading-progress" data-progress-label>0% lido</span>
            </div>
          </div>
        </div>

        <figure class="post-hero">
          <img src={postHeroImage} alt={post.title} class="post-hero-image" />
        </figure>
      </div>
    </header>

    <div class="post-divider"></div>

    <div class="post-body" set:html={post.contentHtml}></div>

    <Comments postSlug={post.slug} />

    <Newsletter dashboardUrl={DASHBOARD_URL} postSlug={post.slug} />

    <footer class="post-footer">
      <a
        href={categoryBackHref}
        class="post-back-footer"
        data-home-href="/"
        data-home-label="Voltar para Home"
        data-category-href={categoryBackHref}
        data-category-label={`Voltar para ${post.category}`}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        <span class="post-back-footer-label">Voltar para {post.category}</span>
      </a>

      <a
        href={categoryNextHref}
        class="post-next-footer"
        data-home-href={`/posts/${nextPost.slug}?from=home`}
        data-home-label="Prox Post"
        data-home-title={nextPost.title}
        data-category-href={categoryNextHref}
        data-category-label="Prox Post"
        data-category-title={nextPost.title}
      >
        <span class="post-next-label">Prox Post</span>
        <span class="post-next-title">{nextPost.title}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    </footer>
  </article>
</Base>

<style>
  .post-page {
    position: relative;
    z-index: 10;
    width: 85%;
    margin: 0 auto;
    padding: 100px 0 80px;
  }

  .post-header {
    opacity: 0;
    animation: fade-up 0.55s ease 0.1s forwards;
  }

  .post-header-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
    gap: 28px;
    align-items: start;
  }

  .post-header-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .post-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    width: fit-content;
    max-width: 100%;
    transition: opacity 0.2s ease;
  }

  .post-back:hover { opacity: 0.7; }

  .post-back-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .post-title {
    margin: 0;
    font-family: monospace;
    font-size: clamp(1.3rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-star);
    text-shadow: 0 0 30px var(--color-star-25);
    letter-spacing: 0.02em;
  }

  .post-tldr-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    max-width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--color-accent-40);
    border-radius: 8px;
    background: var(--color-accent-06);
    font-family: monospace;
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--color-reading-text);
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .post-tldr-cta span {
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .post-tldr-cta:hover,
  .post-tldr-cta:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-accent-08);
    transform: translateY(-1px);
    outline: none;
  }

  .post-theme-row {
    display: none;
  }

  .post-theme {
    margin: -4px 0 0;
    font-family: monospace;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-star);
    opacity: 0.8;
    overflow-wrap: anywhere;
  }

  .post-theme-label {
    color: var(--color-accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: monospace;
    font-size: 0.62rem;
    color: var(--color-star);
    opacity: 0.45;
    letter-spacing: 0.06em;
    flex-wrap: wrap;
  }

  .post-author {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .post-author-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-star-25);
    box-shadow: 0 0 18px var(--color-star-10);
    flex-shrink: 0;
  }

  .post-author-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    overflow: hidden;
  }

  .post-author-name,
  .post-author-role {
    display: block;
    line-height: 1.3;
  }

  .post-author-name {
    color: var(--color-star);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .post-author-role {
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    opacity: 0.6;
  }

  .post-meta-separator {
    width: 1px;
    height: 28px;
    background: linear-gradient(to bottom, transparent, var(--color-star), transparent);
    opacity: 0.25;
  }

  .post-reading-time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .post-reading-progress {
    color: var(--color-accent);
    font-weight: 700;
  }

  .post-reading-progress.completed {
    color: var(--color-star);
    text-shadow: 0 0 12px var(--color-star-25);
  }

  .post-reading-time-mobile {
    display: none;
  }

  .post-divider {
    margin: 32px 0;
    height: 1px;
    background: linear-gradient(to right, var(--color-accent), var(--color-star), transparent);
    opacity: 0.3;
    animation: fade-up 0.55s ease 0.2s both;
  }

  .post-hero {
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--color-star-18);
    background: linear-gradient(135deg, var(--color-star-08), transparent 60%);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.28);
    animation: fade-up 0.55s ease 0.25s both;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .post-hero-image {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    animation: fade-up 0.55s ease 0.3s both;
  }

  .post-body :global(p),
  .post-body :global(li),
  .post-body :global(blockquote) {
    margin: 0;
    font-family: monospace;
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--color-reading-text);
    opacity: 0.85;
  }

  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    margin: 10px 0 -6px;
    font-family: monospace;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-star);
    letter-spacing: 0.04em;
  }

  .post-body :global(h2) {
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
  }

  .post-body :global(h3),
  .post-body :global(h4) {
    font-size: 0.98rem;
  }

  .post-body :global(blockquote) {
    padding: 14px 18px;
    border-left: 2px solid var(--color-accent);
    background: var(--color-star-05);
  }

  .post-body :global(ul) {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .post-body :global(hr) {
    width: 100%;
    height: 1px;
    margin: 4px 0;
    border: 0;
    background: linear-gradient(to right, transparent, var(--color-star-25), transparent);
  }

  .post-body :global(.post-content-image) {
    display: flex;
    justify-content: center;
    margin: 4px 0;
  }

  .post-body :global(.post-content-image img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 680px;
    border-radius: 14px;
    object-fit: contain;
  }

  .post-body :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-40);
  }

  .post-body :global(code) {
    padding: 2px 5px;
    border: 1px solid var(--color-star-16);
    border-radius: 4px;
    background: var(--color-star-05);
    color: var(--color-star);
  }

  .post-footer {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--color-star-10);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    animation: fade-up 0.55s ease 0.4s both;
  }

  .post-back-footer {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-star);
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .post-back-footer-label {
    overflow-wrap: anywhere;
  }

  .post-back-footer:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  .post-next-footer {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 10px;
    text-decoration: none;
    text-align: right;
    transition: opacity 0.2s ease;
    opacity: 0.7;
    min-width: 0;
  }

  .post-next-footer:hover { opacity: 1; }

  .post-next-footer:hover .post-next-title {
    color: var(--color-accent);
  }

  .post-next-footer:hover svg {
    color: var(--color-accent);
  }

  .post-next-footer svg {
    align-self: center;
    flex-shrink: 0;
    color: var(--color-star);
    transition: color 0.2s ease;
  }

  .post-next-label {
    font-family: monospace;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    white-space: nowrap;
    line-height: 1.3;
    flex-shrink: 0;
  }

  .post-next-title {
    font-family: monospace;
    font-size: 0.72rem;
    color: var(--color-star);
    line-height: 1.3;
    transition: color 0.2s ease;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 860px) {
    .post-header-main {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .post-hero {
      max-width: 100%;
    }

    .post-hero-image {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 760px) {
    .newsletter-block {
      flex-direction: column;
      gap: 28px;
      padding: 28px 24px;
    }

    .newsletter-content,
    .newsletter-form {
      width: 100%;
    }

    .newsletter-input-wrap {
      flex-direction: column;
      border-radius: 12px;
    }

    .newsletter-btn {
      width: 100%;
      border-left: none;
      border-top: 1px solid var(--color-star-22);
      padding: 14px 18px;
    }

    .newsletter-overlay {
      inset: 12px;
      padding: 20px 18px;
      gap: 14px;
    }
  }

  @media (max-width: 600px) {
    .post-page {
      width: min(92%, 640px);
      padding: 88px 0 60px;
    }

    .post-header-copy {
      gap: 14px;
    }

    .post-back {
      font-size: 0.62rem;
      letter-spacing: 0.12em;
    }

    .post-tldr-cta {
      font-size: 0.78rem;
      flex-wrap: wrap;
    }

    .post-theme {
      font-size: 0.62rem;
      line-height: 1.5;
    }

    .post-theme-row {
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      width: 100%;
      font-family: monospace;
    }

    .post-theme-row .post-theme {
      flex: 1;
      min-width: 0;
      margin: 0;
    }

    .post-header-copy.is-home-origin .post-meta .post-reading-time {
      display: none;
    }

    .post-header-copy.is-home-origin .post-reading-time-mobile {
      display: inline-flex;
      flex-shrink: 0;
      color: var(--color-star);
      font-size: 0.56rem;
      letter-spacing: 0.06em;
      opacity: 0.55;
      white-space: nowrap;
    }

    .post-meta {
      align-items: flex-start;
      gap: 12px;
    }

    .post-meta-separator {
      display: none;
    }

    .post-author-avatar {
      width: 54px;
      height: 54px;
    }

    .post-author-name {
      font-size: 0.64rem;
    }

    .post-author-role,
    .post-reading-time {
      font-size: 0.56rem;
    }

    .post-body :global(p),
    .post-body :global(li),
    .post-body :global(blockquote) {
      font-size: 0.82rem;
      line-height: 1.8;
    }

    .newsletter-title {
      font-size: 1rem;
    }

    .newsletter-desc {
      font-size: 0.68rem;
    }

    .newsletter-input {
      padding: 14px 16px;
      font-size: 0.74rem;
    }

    .newsletter-btn {
      font-size: 0.64rem;
      letter-spacing: 0.08em;
    }

    .post-footer {
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
    }

    .post-back-footer,
    .post-next-footer {
      width: 100%;
    }

    .post-next-footer {
      justify-content: space-between;
      text-align: left;
      gap: 12px;
    }

    .post-next-title {
      flex: 1;
      font-size: 0.68rem;
    }
  }
</style>

<script>
  import {
    getLocalProgress,
    pushReadingProgress,
    renderReadingProgress,
    saveLocalProgress,
    syncReadingProgress,
  } from '../../lib/reading-progress-client';

  const resolvePostOrigin = () => {
    const fromParam = new URLSearchParams(window.location.search).get('from');
    if (fromParam === 'home' || fromParam === 'category') return fromParam;

    const storedOrigin = sessionStorage.getItem('post-nav-origin');
    if (storedOrigin === 'home' || storedOrigin === 'category') return storedOrigin;

    if (document.referrer) {
      const referrerUrl = new URL(document.referrer);
      if (referrerUrl.origin === window.location.origin) {
        if (referrerUrl.pathname === '/') return 'home';
        if (referrerUrl.pathname.startsWith('/categorias/')) return 'category';
      }
    }

    return 'category';
  };

  const applyPostNavigation = () => {
    const origin = resolvePostOrigin();
    const useHome = origin === 'home';

    const topBack = document.querySelector<HTMLAnchorElement>('.post-back');
    const topBackLabel = document.querySelector<HTMLElement>('.post-back-label');
    const footerBack = document.querySelector<HTMLAnchorElement>('.post-back-footer');
    const footerBackLabel = document.querySelector<HTMLElement>('.post-back-footer-label');
    const footerNext = document.querySelector<HTMLAnchorElement>('.post-next-footer');
    const footerNextLabel = document.querySelector<HTMLElement>('.post-next-label');
    const footerNextTitle = document.querySelector<HTMLElement>('.post-next-title');
    const postHeaderCopy = document.querySelector<HTMLElement>('.post-header-copy');
    const homeOnlyTheme = document.querySelector<HTMLElement>('[data-home-only="true"]');

    if (topBack) {
      topBack.href = useHome ? (topBack.dataset.homeHref ?? '/') : (topBack.dataset.categoryHref ?? '/');
    }

    if (topBackLabel) {
      topBackLabel.textContent = useHome
        ? (topBack?.dataset.homeLabel ?? 'Home')
        : (topBack?.dataset.categoryLabel ?? '');
    }

    if (footerBack) {
      footerBack.href = useHome ? (footerBack.dataset.homeHref ?? '/') : (footerBack.dataset.categoryHref ?? '/');
    }

    if (footerBackLabel) {
      footerBackLabel.textContent = useHome
        ? (footerBack?.dataset.homeLabel ?? 'Voltar para Home')
        : (footerBack?.dataset.categoryLabel ?? '');
    }

    if (footerNext) {
      footerNext.href = useHome ? (footerNext.dataset.homeHref ?? '/') : (footerNext.dataset.categoryHref ?? '/');
    }

    if (footerNextLabel) {
      footerNextLabel.textContent = useHome
        ? (footerNext?.dataset.homeLabel ?? 'Prox Post')
        : (footerNext?.dataset.categoryLabel ?? 'Prox Post');
    }

    if (footerNextTitle) {
      footerNextTitle.textContent = useHome
        ? (footerNext?.dataset.homeTitle ?? '')
        : (footerNext?.dataset.categoryTitle ?? '');
    }

    postHeaderCopy?.classList.toggle('is-home-origin', useHome);

    if (homeOnlyTheme) {
      homeOnlyTheme.style.display = useHome ? 'flex' : 'none';
    }
  };

  applyPostNavigation();

  const postPage = document.querySelector<HTMLElement>('.post-page[data-post-slug]');
  const postBody = document.querySelector<HTMLElement>('.post-body');
  const postSlug = postPage?.dataset.postSlug;
  const dashboardUrl = postPage?.dataset.dashboardUrl;
  let lastSentProgress = postSlug ? getLocalProgress(postSlug).progress : 0;
  let ticking = false;

  function calculateReadingProgress(): number {
    if (!postBody) return 0;

    const viewportMarker = window.scrollY + window.innerHeight * 0.72;
    const start = postBody.offsetTop;
    const end = postBody.offsetTop + postBody.offsetHeight;
    const distance = Math.max(1, end - start);

    return Math.min(100, Math.max(0, Math.round(((viewportMarker - start) / distance) * 100)));
  }

  function updateReadingProgress(sendToServer: boolean): void {
    if (!postPage || !postSlug) return;

    const progress = calculateReadingProgress();
    const completed = progress >= 90;
    const current = getLocalProgress(postSlug);
    const nextProgress = Math.max(current.progress, progress);

    if (nextProgress <= current.progress && current.completed) {
      renderReadingProgress(postPage, postSlug);
      return;
    }

    if (dashboardUrl && sendToServer && (nextProgress - lastSentProgress >= 5 || completed)) {
      lastSentProgress = nextProgress;
      void pushReadingProgress(dashboardUrl, postSlug, nextProgress, completed).then(() => {
        renderReadingProgress(postPage, postSlug);
      });
      return;
    }

    if (!dashboardUrl || nextProgress > current.progress || completed) {
      saveLocalProgress(postSlug, nextProgress, completed);
      renderReadingProgress(postPage, postSlug);
    }
  }

  if (postPage && postSlug) {
    renderReadingProgress(postPage, postSlug);

    if (dashboardUrl) {
      void syncReadingProgress(dashboardUrl, [postSlug]).then(() => {
        lastSentProgress = getLocalProgress(postSlug).progress;
        renderReadingProgress(postPage, postSlug);
        updateReadingProgress(false);
      });
    } else {
      updateReadingProgress(false);
    }

    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        ticking = false;
        updateReadingProgress(true);
      });
    }, { passive: true });

    window.addEventListener('resize', () => updateReadingProgress(false));
    window.addEventListener('pagehide', () => updateReadingProgress(true));
  }
</script>
