---
export const prerender = false;

import PageLayout from '../layouts/PageLayout.astro';
import BlackHole from '../components/BlackHole.astro';
import DailyVideoIntro from '../components/DailyVideoIntro.astro';
import PostCarousel from '../components/PostCarousel.astro';
import PostFeed from '../components/PostFeed.astro';
import { HOME_POSTS_PER_PAGE } from '../lib/post-listing';
import { fetchPosts } from '../lib/posts';

const posts = await fetchPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / HOME_POSTS_PER_PAGE));
---

<PageLayout title="Devs à Deriva">
  <Fragment slot="head">
    {totalPages > 1 && <link rel="next" href="https://devsaderiva.com.br/page/2/" />}
    <script is:inline src="/daily-intro-bootstrap.js"></script>
  </Fragment>
  <BlackHole />
  <DailyVideoIntro />
  <main id="main-content" class="page-overlay" tabindex="-1">
    <div id="home-content" class="home-content">
      <PostCarousel posts={posts} />
      <PostFeed posts={posts.slice(0, HOME_POSTS_PER_PAGE)} totalPages={totalPages} />
    </div>
  </main>
</PageLayout>

<style>
  .page-overlay {
    position: relative;
    z-index: 10;
    margin-top: -100vh;
    min-height: 100vh;
    padding: clamp(172px, 9vw, 200px) 24px 64px;
    pointer-events: none;
  }
  .home-content {
    display: flex;
    flex-direction: column;
    gap: 64px;
    width: min(100%, 1440px);
    min-width: 0;
    margin-inline: auto;
    pointer-events: auto;
  }
  @media (max-width: 768px) {
    .page-overlay { padding: 120px 16px 48px; }
    .home-content { gap: 48px; }
  }
</style>
