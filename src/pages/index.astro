---
export const prerender = false;

import PageLayout from '../layouts/PageLayout.astro';
import BlackHole from '../components/BlackHole.astro';
import PostCard from '../components/PostCard.astro';
import { fetchPosts, isApiOffline } from '../lib/posts';

const allPosts = await fetchPosts();
const DASHBOARD_URL = import.meta.env.PUBLIC_DASHBOARD_URL ?? 'http://localhost:3000';

const PAGE_SIZE = 5;
const SITE = 'https://devsaderiva.com.br';

const categoryImages: Record<string, string> = {
  aleatoriedades: '/aleatoriedades-astronaut-body.webp',
  carreira: '/carreira-profissional-astronaut-body.webp',
  livros: '/livros-astronaut.webp',
  musica: '/musica-astronaut.webp',
  noticias: '/noticias-astronaut.webp',
  tech: '/tech-astronaut.webp',
};

const total = allPosts.length;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const hasMore = total > PAGE_SIZE;

const visibleHomePosts = allPosts.slice(0, PAGE_SIZE).map((post, index) => ({
  ...post,
  sectionId: `section-${index + 1}`,
  href: `/posts/${post.slug}?from=home`,
  authorBio: post.author.role,
  imageSrc: post.thumbUrl ?? categoryImages[post.categorySlug] ?? '/logo-high-color.webp',
}));
---

<PageLayout title="Devs à Deriva">
  <Fragment slot="head">
    {hasMore && <link rel="next" href={`${SITE}/page/2/`} />}
  </Fragment>
  <BlackHole />
    <main id="main-content" class="page-overlay">
      <div
        id="sections-container"
        class="sections-container"
        data-dashboard-url={DASHBOARD_URL}
        data-total-pages={String(totalPages)}
        data-has-more={String(hasMore)}
      >
        {visibleHomePosts.length === 0 && (
          <div class="empty-state">
            <p>{isApiOffline()
              ? '> api indisponível no momento do build. tente novamente mais tarde.'
              : '> nenhum post publicado ainda. volte em breve.'
            }</p>
          </div>
        )}
        {visibleHomePosts.map((post) => (
          <PostCard
            slug={post.slug}
            sectionId={post.sectionId}
            href={post.href}
            title={post.title}
            category={post.category}
            excerpt={post.excerpt}
            imageSrc={post.imageSrc}
            author={post.author}
            authorBio={post.authorBio}
          />
        ))}

        <div id="scroll-sentinel" aria-hidden="true" style="height:1px"></div>

        <div class="load-more-wrap">
          <div id="posts-loading" class="posts-loading-dots" hidden aria-label="Carregando posts">
            <span class="dot" style="animation-delay:0s">.</span>
            <span class="dot" style="animation-delay:0.2s">.</span>
            <span class="dot" style="animation-delay:0.4s">.</span>
          </div>
          <button
            id="load-more-btn"
            class="load-more-cta"
            type="button"
            hidden={!hasMore}
            aria-label="Carregar mais posts"
          >
            CARREGAR MAIS TRANSMISSÕES
          </button>
          <p id="end-of-feed" class="end-of-feed" hidden>Você chegou ao fundo do mar.</p>
          <p id="load-error" class="load-error" hidden>
            Falha ao carregar. <button class="retry-btn" type="button">Tentar novamente</button>
          </p>
        </div>
      </div>
      <div id="posts-status" aria-live="polite" aria-atomic="true" class="sr-only"></div>
    </main>
</PageLayout>

<style>

    .page-overlay {
      position: relative;
      z-index: 10;
      display: flex;
      justify-content: center;
      margin-top: -100vh;
      min-height: 100vh;
      padding: clamp(172px, 9vw, 200px) 24px 48px;
      pointer-events: none;
    }

    .sections-container {
      width: 70%;
      max-width: 1100px;
      min-height: calc((100vh - clamp(72px, 9vw, 100px)) * 0.7);
      display: flex;
      flex-direction: column;
      gap: 35px;
      transform: translate3d(-72px, 0, 0);
      opacity: 0;
      transition: opacity 1.2s ease-in-out, transform 1.2s ease-in-out;
      pointer-events: auto;
    }

    .empty-state {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 24px;
    }

    .empty-state p {
      font-family: monospace;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      color: var(--color-star);
      opacity: 0.35;
      margin: 0;
    }

    :global(.title-link) {
      color: var(--color-text);
    }

    .load-more-wrap {
      display: flex;
      justify-content: center;
      margin-top: 100px;
      padding-bottom: 24px;
    }

    .load-more-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 14px 32px;
      background: transparent;
      border: 1px dashed var(--color-accent);
      border-radius: 6px;
      cursor: pointer;
      color: var(--color-accent);
      text-decoration: none;
      font-size: 0.72rem;
      font-family: monospace;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      transition: box-shadow 0.25s ease, background 0.25s ease;
    }

    .load-more-cta:hover,
    .load-more-cta:focus-visible {
      box-shadow: 0 0 18px var(--color-accent-20);
      background: transparent;
      outline: none;
    }

    .load-more-cta:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }

    .posts-loading-dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 8px 16px;
      color: var(--color-star);
      font-size: 1.4rem;
      font-family: monospace;
      letter-spacing: 0.1em;
    }

    .end-of-feed {
      font-family: monospace;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      color: var(--color-star);
      opacity: 0.4;
      text-align: center;
      padding: 16px;
      margin: 0;
    }

    .load-error {
      font-family: monospace;
      font-size: 0.72rem;
      text-align: center;
      color: var(--color-star);
      opacity: 0.7;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .retry-btn {
      background: none;
      border: none;
      color: var(--color-accent);
      font-family: monospace;
      font-size: 0.72rem;
      cursor: pointer;
      text-decoration: underline;
      padding: 0;
    }

    .retry-btn:hover {
      opacity: 0.8;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .limbo-overlay {
      position: fixed;
      inset: 0;
      z-index: 40;
      pointer-events: none;
    }

    .limbo-slice {
      position: fixed;
      left: 0;
      top: 0;
      overflow: hidden;
      will-change: transform, opacity, filter;
    }

    .limbo-slice-content {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      transform-origin: center center;
    }

    .dot {
      display: inline-block;
      animation: wave-dot 1.2s ease-in-out infinite;
    }

    @keyframes wave-dot {
      0%, 100% { transform: translateY(0);    opacity: 1;   }
      50%       { transform: translateY(-4px); opacity: 0.4; }
    }

    @media (max-width: 1024px) {
      .page-overlay {
        padding-inline: 20px;
      }

      .sections-container {
        gap: 32px;
        transform: translate3d(0, 24px, 0);
      }

      .load-more-wrap {
        margin-top: 80px;
      }
    }

    @media (max-width: 768px) {
      .page-overlay {
        margin-top: -100svh;
        padding: 136px 16px 32px;
      }

      .sections-container {
        width: 95%;
        min-height: auto;
        gap: 24px;
      }

      .load-more-wrap {
        margin-top: 64px;
      }

      .load-more-cta {
        min-width: 220px;
        padding: 11px 18px;
        font-size: 0.68rem;
      }
    }

    @media (max-width: 480px) {
      .page-overlay {
        padding-top: 120px;
      }

      .sections-container {
        gap: 18px;
      }

      .load-more-wrap {
        margin-top: 48px;
      }

      .load-more-cta {
        width: 100%;
        min-width: 0;
        font-size: 0.64rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #sections-container,
      .dot {
        animation: none !important;
        transition: none !important;
      }

      #sections-container {
        transform: none !important;
      }
    }
  </style>

  <script>
    type HomePost = {
      slug: string; title: string; category: string; categorySlug: string;
      excerpt: string; author: { name: string; photo: string; role: string };
      sectionId: string; href: string; authorBio: string; imageSrc: string;
    };

    const container = document.getElementById('sections-container');
    let hasMore = container?.dataset.hasMore === 'true';
    let currentPage = 1;
    let isLoading = false;

    const sentinel = document.getElementById('scroll-sentinel');
    const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement | null;
    const loadingEl = document.getElementById('posts-loading');
    const endOfFeedEl = document.getElementById('end-of-feed');
    const loadErrorEl = document.getElementById('load-error');
    const statusEl = document.getElementById('posts-status');

    function escapeHtml(value: unknown): string {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    function renderPostSection(post: HomePost): string {
      return `
        <div class="content-section" data-section-id="${escapeHtml(post.sectionId)}" data-post-slug="${escapeHtml(post.slug)}" data-post-href="${escapeHtml(post.href)}" role="link" tabindex="0">
          <div class="section-image"><img src="${escapeHtml(post.imageSrc)}" alt="${escapeHtml(post.category)}" class="section-img" loading="lazy" decoding="async" /></div>
          <div class="section-content">
            <a href="${escapeHtml(post.href)}" class="limbo-cta">Lançar ao limbo</a>
            <h2><a href="${escapeHtml(post.href)}" class="title-link">${escapeHtml(post.title)}</a></h2>
            <p>${escapeHtml(post.excerpt)}</p>
            <a href="${escapeHtml(post.href)}" class="cta-read">Continuar leitura <span class="dot" style="animation-delay:0s">.</span><span class="dot" style="animation-delay:0.2s">.</span><span class="dot" style="animation-delay:0.4s">.</span></a>
            <div class="card-footer">
              <div class="post-meta">
                <img class="post-author-photo" src="${escapeHtml(post.author.photo)}" alt="Foto de ${escapeHtml(post.author.name)}" loading="lazy" decoding="async" />
                <div class="post-author-copy">
                  <span class="post-author-name">${escapeHtml(post.author.name)}</span>
                  <span class="post-author-bio">${escapeHtml(post.authorBio)}</span>
                </div>
              </div>
              <span class="category-badge">${escapeHtml(post.category)}</span>
            </div>
          </div>
        </div>
      `;
    }

    function setLoadingState(loading: boolean) {
      if (loading) {
        loadMoreBtn?.setAttribute('hidden', '');
        loadingEl?.removeAttribute('hidden');
      } else {
        loadingEl?.setAttribute('hidden', '');
        if (hasMore) loadMoreBtn?.removeAttribute('hidden');
      }
    }

    function showEndOfFeed() {
      endOfFeedEl?.removeAttribute('hidden');
      loadMoreBtn?.setAttribute('hidden', '');
      loadingEl?.setAttribute('hidden', '');
      if (sentinel) observer.unobserve(sentinel);
    }

    async function loadNextPage() {
      if (isLoading || !hasMore) return;
      isLoading = true;
      loadErrorEl?.setAttribute('hidden', '');
      setLoadingState(true);

      try {
        const res = await fetch(`/api/posts.json?page=${currentPage + 1}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const data = await res.json() as {
          posts: HomePost[];
          currentPage: number;
          hasNextPage: boolean;
        };

        const newPosts = data.posts;

        if (newPosts.length > 0 && sentinel && container) {
          sentinel.insertAdjacentHTML('beforebegin', newPosts.map(renderPostSection).join(''));
          currentPage = data.currentPage;

          const newSections = Array.from(
            container.querySelectorAll<HTMLElement>('.content-section[data-post-slug]:not([data-progress-init])')
          );
          newSections.forEach(s => s.setAttribute('data-progress-init', ''));
          document.dispatchEvent(new CustomEvent('home-posts-added', { detail: { sections: newSections } }));

          if (statusEl) {
            statusEl.textContent = `${newPosts.length} posts carregados.`;
            setTimeout(() => { statusEl.textContent = ''; }, 2000);
          }
        }

        hasMore = data.hasNextPage;
        setLoadingState(false);

        if (!hasMore) showEndOfFeed();
      } catch {
        isLoading = false;
        setLoadingState(false);
        loadErrorEl?.removeAttribute('hidden');
        return;
      }

      isLoading = false;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) loadNextPage();
        }
      },
      { rootMargin: '0px 0px 300px 0px' },
    );

    if (sentinel && hasMore) observer.observe(sentinel);

    loadMoreBtn?.addEventListener('click', loadNextPage);

    loadErrorEl?.querySelector<HTMLButtonElement>('.retry-btn')?.addEventListener('click', () => {
      loadErrorEl?.setAttribute('hidden', '');
      loadNextPage();
    });

    // Mark initial server-rendered posts so new ones can be detected
    document.querySelectorAll<HTMLElement>('.content-section[data-post-slug]').forEach(s => {
      s.setAttribute('data-progress-init', '');
    });
  </script>

  <script>
    import { renderReadingProgress, syncReadingProgress } from '../lib/reading-progress-client';

    const INTRO_KEY = 'intro_last_shown';
    const TODAY     = new Date().toISOString().slice(0, 10);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function revealContent() {
      const container = document.getElementById('sections-container');
      if (container) {
        container.style.opacity  = '1';
        container.style.transform = 'translate3d(0, 0, 0)';
      }
    }

    if (localStorage.getItem(INTRO_KEY) === TODAY || reduceMotion) {
      revealContent();
    } else {
      window.addEventListener('animationComplete', revealContent, { once: true });
    }

    const progressContainer = document.getElementById('sections-container') as HTMLElement | null;
    const dashboardUrl = progressContainer?.dataset.dashboardUrl;
    const progressSections = Array.from(document.querySelectorAll<HTMLElement>('.content-section[data-post-slug]'));
    const postSlugs = progressSections
      .map((section) => section.dataset.postSlug)
      .filter((slug): slug is string => Boolean(slug));

    progressSections.forEach((section) => {
      const postSlug = section.dataset.postSlug;
      if (postSlug) renderReadingProgress(section, postSlug);
    });

    if (dashboardUrl) {
      void syncReadingProgress(dashboardUrl, postSlugs).then(() => {
        progressSections.forEach((section) => {
          const postSlug = section.dataset.postSlug;
          if (postSlug) renderReadingProgress(section, postSlug);
        });
      });
    }

    const navigateToPost = (href: string | undefined) => {
      if (!href) return;
      sessionStorage.setItem('post-nav-origin', 'home');
      window.location.href = href;
    };

    progressContainer?.addEventListener('click', (event: MouseEvent) => {
      const target = event.target as HTMLElement | null;

      // Limbo-cta: prevent navigation, trigger vanish animation
      const cta = target?.closest<HTMLElement>('.limbo-cta');
      if (cta) {
        event.preventDefault();
        const section = cta.closest<HTMLElement>('.content-section');
        if (section) vanishSectionSequential(section);
        return;
      }

      const link = target?.closest<HTMLAnchorElement>('.content-section a[href*="/posts/"]');
      if (link) {
        sessionStorage.setItem('post-nav-origin', 'home');
        return;
      }

      const section = target?.closest<HTMLElement>('.content-section[data-post-href]');
      if (!section || target?.closest('a, button')) return;
      navigateToPost(section.dataset.postHref);
    });

    progressContainer?.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;

      const target = event.target as HTMLElement | null;
      const section = target?.closest<HTMLElement>('.content-section[data-post-href]');
      if (!section || target?.closest('a, button')) return;

      event.preventDefault();
      navigateToPost(section.dataset.postHref);
    });

    function spaghettifyElement(el: HTMLElement, bhX: number, bhY: number, duration: number): Promise<void> {
      return new Promise(resolve => {
        const rect = el.getBoundingClientRect();
        if (rect.width === 0 && rect.height === 0) { resolve(); return; }

        const clone = el.cloneNode(true) as HTMLElement;
        clone.style.cssText = [
          `position:fixed`,
          `left:${rect.left}px`,
          `top:${rect.top}px`,
          `width:${rect.width}px`,
          `height:${rect.height}px`,
          `margin:0`,
          `z-index:9999`,
          `pointer-events:none`,
          `transform-origin:left center`,
        ].join(';');
        document.body.appendChild(clone);
        el.style.visibility = 'hidden';

        const rx = rect.right;
        const ry = rect.top + rect.height / 2;
        const dx = bhX - rx;
        const dy = bhY - ry;
        const len = Math.max(1, Math.sqrt(dx * dx + dy * dy));
        const nx = dx / len;
        const ny = dy / len;

        const cx = rect.left + rect.width  / 2;
        const cy = rect.top  + rect.height / 2;
        const tdx = bhX - cx;
        const tdy = bhY - cy;

        const start = performance.now();

        function frame(now: number) {
          const p    = Math.min(1, (now - start) / duration);
          const ease = p * p * (3 - 2 * p);
          const mx = tdx * ease;
          const my = tdy * ease;
          const distP   = Math.max(0, (p - 0.7) / 0.3);
          const stretch = 1 + distP * distP * 8.0;
          const squish  = Math.max(0.02, 1 - distP * distP * 0.96);
          const skewX   = nx * ny * distP * distP * 1.2;
          const scaleX = squish + Math.abs(nx) * (stretch - squish);
          const scaleY = squish + Math.abs(ny) * (stretch - squish);
          const opacity = Math.max(0, 1 - Math.max(0, (p - 0.8) / 0.2));

          clone.style.transform = `translate(${mx}px,${my}px) matrix(${scaleX},0,${skewX},${scaleY},0,0)`;
          clone.style.opacity   = String(opacity);

          if (p < 1) { requestAnimationFrame(frame); }
          else       { clone.remove(); resolve(); }
        }

        requestAnimationFrame(frame);
      });
    }

    function collapseShell(section: HTMLElement, bhX: number, bhY: number): Promise<void> {
      return new Promise(resolve => {
        const rect = section.getBoundingClientRect();
        const cx = rect.left + rect.width  / 2;
        const cy = rect.top  + rect.height / 2;
        const dx = bhX - cx;
        const dy = bhY - cy;
        const start    = performance.now();
        const duration = 500;

        section.style.transition      = 'none';
        section.style.transformOrigin = 'left center';

        const len = Math.max(1, Math.sqrt(dx * dx + dy * dy));
        const nx  = dx / len;
        const ny  = dy / len;

        function frame(now: number) {
          const p    = Math.min(1, (now - start) / duration);
          const ease = p * p * (3 - 2 * p);
          const moveX = dx * ease;
          const moveY = dy * ease;
          const distP   = Math.max(0, (p - 0.7) / 0.3);
          const stretch = 1 + distP * distP * 8.0;
          const squish  = Math.max(0.01, 1 - distP * distP * 0.96);
          const skewX   = nx * ny * distP * distP * 1.2;
          const scaleX  = squish + Math.abs(nx) * (stretch - squish);
          const scaleY  = squish + Math.abs(ny) * (stretch - squish);
          const opacity = Math.max(0, 1 - Math.max(0, (p - 0.8) / 0.2));
          const borderA = Math.max(0, 1 - p * 2.5);

          section.style.transform   = `translate(${moveX}px,${moveY}px) matrix(${scaleX},0,${skewX},${scaleY},0,0)`;
          section.style.opacity     = String(opacity);
          section.style.borderColor = `rgba(0,212,232,${borderA})`;

          if (p < 1) { requestAnimationFrame(frame); }
          else       { section.remove(); resolve(); }
        }

        requestAnimationFrame(frame);
      });
    }

    function sleep(ms: number) {
      return new Promise<void>(r => setTimeout(r, ms));
    }

    async function vanishSectionSequential(section: HTMLElement) {
      if (section.classList.contains('is-vanishing')) return;
      if (reduceMotion) {
        section.remove();
        return;
      }
      section.classList.add('is-vanishing');
      section.style.pointerEvents = 'none';

      const bhX = window.innerWidth;
      const bhY = 0;

      const limboBtn = section.querySelector('.limbo-cta') as HTMLElement | null;
      if (limboBtn) await spaghettifyElement(limboBtn, bhX, bhY, 420);

      await sleep(80);

      const sectionContent = section.querySelector('.section-content') as HTMLElement | null;
      if (sectionContent) await spaghettifyElement(sectionContent, bhX, bhY, 520);

      await sleep(80);

      const sectionImage = section.querySelector('.section-image') as HTMLElement | null;
      if (sectionImage) await spaghettifyElement(sectionImage, bhX, bhY, 560);

      await sleep(60);
      await collapseShell(section, bhX, bhY);
    }

    // Limbo-cta handling moved to delegated click handler on progressContainer above

    // Apply reading progress to posts loaded via infinite scroll
    document.addEventListener('home-posts-added', ((e: Event) => {
      const { sections } = (e as CustomEvent<{ sections: HTMLElement[] }>).detail;
      for (const section of sections) {
        const postSlug = section.dataset.postSlug;
        if (postSlug) renderReadingProgress(section, postSlug);
      }
      if (dashboardUrl) {
        const newSlugs = sections
          .map(s => s.dataset.postSlug)
          .filter((slug): slug is string => Boolean(slug));
        void syncReadingProgress(dashboardUrl, newSlugs).then(() => {
          for (const section of sections) {
            const postSlug = section.dataset.postSlug;
            if (postSlug) renderReadingProgress(section, postSlug);
          }
        });
      }
    }) as EventListener);

    const PROGRESS_CIRCUMFERENCE = 43.98;

    function applyReadingProgress(section: HTMLElement, percent: number) {
      const fill = section.querySelector('.progress-ring-fill') as SVGCircleElement | null;
      const text = section.querySelector('.progress-text') as HTMLElement | null;
      if (!fill || !text) return;

      const clamped = Math.min(100, Math.max(0, percent));
      const offset = PROGRESS_CIRCUMFERENCE * (1 - clamped / 100);
      fill.style.strokeDashoffset = String(offset);
      text.textContent = `${Math.round(clamped)}% lido`;

      const done = clamped >= 100;
      fill.classList.toggle('completed', done);
      text.classList.toggle('completed', done);
    }

    function loadReadingProgress() {
      document.querySelectorAll<HTMLElement>('.content-section').forEach(section => {
        const id = section.getAttribute('data-section-id');
        if (!id) return;
        const saved = localStorage.getItem(`reading-progress-${id}`);
        if (saved !== null) {
          applyReadingProgress(section, parseFloat(saved));
        }
      });
    }

    (window as any).setReadingProgress = function(sectionId: string, percent: number) {
      localStorage.setItem(`reading-progress-${sectionId}`, String(percent));
      const section = document.querySelector<HTMLElement>(
        `.content-section[data-section-id="${sectionId}"]`
      );
      if (section) applyReadingProgress(section, percent);
    };

    loadReadingProgress();
  </script>
