---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import CategoriaPage from '../../components/CategoriaPage.astro';
import StarBackground from '../../components/StarBackground.astro';
import { getCategoryBySlug } from '../../lib/categories';

const { categoria } = Astro.params;
if (!categoria) return Astro.redirect('/404');

const cat = getCategoryBySlug(categoria);
if (!cat) return Astro.redirect('/404');

const ogImage = `https://devsaderiva.com.br${cat.illustration}`;
---

<Base title={`${cat.label} · Devs à Deriva`} ogImage={ogImage}>
  <StarBackground />
  <CategoriaPage
    category={cat.label}
    categorySlug={cat.slug}
    description={cat.description}
    cornerIllustration={cat.illustration}
    animateIllustration
  />
</Base>
