---
export const prerender = false;

import CategoryLayout from '../../layouts/CategoryLayout.astro';
import CategoriaPage from '../../components/CategoriaPage.astro';
import { getCategoryBySlug } from '../../lib/categories';
import { CATEGORY_POSTS_PER_PAGE } from '../../lib/post-listing';
import { getPostsByCategory } from '../../lib/posts';

const { categoria } = Astro.params;
if (!categoria) return Astro.redirect('/404');

const cat = getCategoryBySlug(categoria);
if (!cat) return Astro.redirect('/404');

const PAGE_SIZE = CATEGORY_POSTS_PER_PAGE;
const totalPosts = (await getPostsByCategory(cat.slug)).length;
const hasNextPage = totalPosts > PAGE_SIZE;
const ogImage = `https://devsaderiva.com.br${cat.illustration}`;
---

<CategoryLayout category={cat} ogImage={ogImage}>
  <Fragment slot="head">
    {hasNextPage && <link rel="next" href={`https://devsaderiva.com.br/categorias/${cat.slug}/pagina/2/`} />}
  </Fragment>
  <CategoriaPage
    category={cat.label}
    categorySlug={cat.slug}
    description={cat.description}
    cornerIllustration={cat.illustration}
    animateIllustration
  />
</CategoryLayout>
