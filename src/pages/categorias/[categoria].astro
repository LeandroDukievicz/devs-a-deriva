---
export const prerender = false;

import CategoryLayout from '../../layouts/CategoryLayout.astro';
import CategoriaPage from '../../components/CategoriaPage.astro';
import { getCategoryBySlug } from '../../lib/categories';
import { CATEGORY_POSTS_PER_PAGE } from '../../lib/post-listing';
import { getPostsByCategory } from '../../lib/posts';

const { categoria } = Astro.params;
if (!categoria) return Astro.redirect('/404');
const cat = await getCategoryBySlug(categoria);
if (!cat) return Astro.redirect('/404');
const posts = await getPostsByCategory(cat.slug);
const hasNextPage = posts.length > CATEGORY_POSTS_PER_PAGE;
---

<CategoryLayout category={cat}>
  <Fragment slot="head">
    {hasNextPage && <link rel="next" href={`https://devsaderiva.com.br/categorias/${cat.slug}/pagina/2/`} />}
  </Fragment>
  <CategoriaPage category={cat} posts={posts} />
</CategoryLayout>
