---
export const prerender = false;

import CategoryLayout from '../../../../layouts/CategoryLayout.astro';
import CategoriaPage from '../../../../components/CategoriaPage.astro';
import { CATEGORY_POSTS_PER_PAGE, isPositiveIntegerString } from '../../../../lib/post-listing';
import { getPostsByCategory } from '../../../../lib/posts';
import { getCategoryBySlug } from '../../../../lib/categories';

const { categoria, n } = Astro.params;
if (!categoria || !n) return Astro.redirect('/404');
const cat = await getCategoryBySlug(categoria);
if (!cat) return Astro.redirect('/404');
if (!isPositiveIntegerString(n) || n === '1') return Astro.redirect(`/categorias/${cat.slug}/`);
const page = Number(n);
const posts = await getPostsByCategory(cat.slug);
const totalPages = Math.max(1, Math.ceil(posts.length / CATEGORY_POSTS_PER_PAGE));
if (page > totalPages) return Astro.redirect(totalPages === 1 ? `/categorias/${cat.slug}/` : `/categorias/${cat.slug}/pagina/${totalPages}/`);
const base = `/categorias/${cat.slug}`;
const prevUrl = page === 2 ? `${base}/` : `${base}/pagina/${page - 1}/`;
---

<CategoryLayout category={cat} title={`${cat.label} · Página ${page} · Devs à Deriva`}>
  <Fragment slot="head">
    <link rel="prev" href={`https://devsaderiva.com.br${prevUrl}`} />
    {page < totalPages && <link rel="next" href={`https://devsaderiva.com.br${base}/pagina/${page + 1}/`} />}
  </Fragment>
  <CategoriaPage category={cat} posts={posts} currentPage={page} />
</CategoryLayout>
