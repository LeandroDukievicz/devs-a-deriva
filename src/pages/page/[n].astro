---
export const prerender = false;

import PageLayout from '../../layouts/PageLayout.astro';
import PostFeed from '../../components/PostFeed.astro';
import { HOME_POSTS_PER_PAGE, isPositiveIntegerString } from '../../lib/post-listing';
import { fetchPosts, paginatePosts } from '../../lib/posts';

const { n } = Astro.params;
if (!n || !isPositiveIntegerString(n) || n === '1') return Astro.redirect('/');
const page = Number(n);
const posts = await fetchPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / HOME_POSTS_PER_PAGE));
if (page > totalPages) return Astro.redirect(totalPages === 1 ? '/' : `/page/${totalPages}/`);
const { items } = paginatePosts(posts, page, HOME_POSTS_PER_PAGE);
const prevHref = page === 2 ? '/' : `/page/${page - 1}/`;
---

<PageLayout title={`Devs à Deriva — Página ${page}`} description={`Artigos do Devs à Deriva em ordem de publicação — página ${page}.`} starBackground starBackgroundTone="home">
  <Fragment slot="head">
    <link rel="prev" href={`https://devsaderiva.com.br${prevHref}`} />
    {page < totalPages && <link rel="next" href={`https://devsaderiva.com.br/page/${page + 1}/`} />}
  </Fragment>
  <main id="main-content" class="archive-page">
    <header class="archive-header">
      <h1>Arquivo de publicações</h1>
      <a href="/">← Início</a>
    </header>
    <PostFeed posts={items} currentPage={page} totalPages={totalPages} />
  </main>
</PageLayout>

<style>
  .archive-page { position: relative; z-index: 10; width: min(100% - 48px, 1440px); margin-inline: auto; padding: 172px 0 64px; min-height: 100vh; }
  .archive-header { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 40px; }
  h1 { margin: 0; color: var(--color-text); font: 600 clamp(1.1rem, 2vw, 1.5rem)/1.4 monospace; }
  .archive-header a { color: var(--color-star); font: .75rem/1.4 monospace; text-decoration: none; }
  .archive-header a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  @media (max-width: 768px) { .archive-page { width: calc(100% - 32px); padding-top: 120px; } }
</style>
