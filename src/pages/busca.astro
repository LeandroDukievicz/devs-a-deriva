---
export const prerender = false;

import PageLayout from '../layouts/PageLayout.astro';
import { fetchPosts, isApiOffline } from '../lib/posts';

const allPosts = await fetchPosts();

// Only expose public fields — no emails, IDs or private metadata
const searchIndex = allPosts.map((post) => ({
  slug: post.slug,
  title: post.title,
  excerpt: post.excerpt,
  category: post.category,
  categorySlug: post.categorySlug,
  authorName: post.author.name,
  publishedAt: post.publishedAt ?? null,
}));

function safeJson(data: unknown): string {
  return JSON.stringify(data).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
}
---

<PageLayout
  title="Busca · Devs à Deriva"
  description="Busque posts por título, resumo, categoria ou autor no Devs à Deriva."
>
  <main id="main-content" class="busca-page">
    <div class="busca-container">
      <header class="busca-header">
        <span class="busca-kicker">&gt;_ busca</span>
        <h1 class="busca-title">Encontre um post</h1>
        <p class="busca-subtitle">Pesquise por título, resumo, categoria ou autor.</p>
      </header>

      {isApiOffline() && (
        <p class="busca-api-warn">
          &gt; api indisponível no momento do build. índice de busca pode estar incompleto.
        </p>
      )}

      <div class="busca-field">
        <label for="busca-input" class="sr-only">Buscar posts</label>
        <div class="busca-input-wrap">
          <svg
            class="busca-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            id="busca-input"
            type="search"
            class="busca-input"
            placeholder="> buscar posts..."
            autocomplete="off"
            spellcheck="false"
            aria-controls="busca-results"
            aria-label="Buscar posts"
          />
          <button
            class="busca-clear"
            id="busca-clear"
            type="button"
            aria-label="Limpar busca"
            hidden
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
        <p class="busca-hint" id="busca-hint" aria-live="polite" aria-atomic="true"></p>
      </div>

      <div id="busca-results" role="region" aria-label="Resultados da busca">
        <p class="busca-state" id="busca-state-idle">&gt; nenhum termo buscado ainda.</p>
        <p class="busca-state busca-state--empty" id="busca-state-no-posts" hidden>
          &gt; nenhum post publicado no índice.
        </p>
        <p class="busca-state" id="busca-state-no-results" hidden>
          &gt; nenhum resultado encontrado.
        </p>
        <ul class="busca-list" id="busca-list" role="list" hidden></ul>
      </div>
    </div>
    <script id="busca-data" type="application/json" set:html={safeJson(searchIndex)} />
  </main>
</PageLayout>

<script>
  const searchIndex: Array<{
    slug: string; title: string; excerpt: string; category: string;
    categorySlug: string; authorName: string; publishedAt: string | null;
  }> = JSON.parse(document.getElementById('busca-data')!.textContent!);
  type Post = typeof searchIndex[number];
  const inputEl   = document.getElementById('busca-input') as HTMLInputElement | null;
  const clearBtn  = document.getElementById('busca-clear') as HTMLButtonElement | null;
  const hintEl    = document.getElementById('busca-hint') as HTMLElement | null;
  const listEl    = document.getElementById('busca-list') as HTMLElement | null;
  const stateIdle = document.getElementById('busca-state-idle') as HTMLElement | null;
  const stateNoPosts   = document.getElementById('busca-state-no-posts') as HTMLElement | null;
  const stateNoResults = document.getElementById('busca-state-no-results') as HTMLElement | null;

  const MONTHS = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];

  function fmtDate(iso: string | null): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    return `${String(d.getUTCDate()).padStart(2,'0')} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
  }

  function setUI({ idle = false, noPosts = false, noResults = false, results = false } = {}) {
    if (stateIdle)     stateIdle.hidden     = !idle;
    if (stateNoPosts)  stateNoPosts.hidden  = !noPosts;
    if (stateNoResults) stateNoResults.hidden = !noResults;
    if (listEl)        listEl.hidden        = !results;
  }

  function render(items: Post[]) {
    listEl!.innerHTML = '';
    for (const post of items) {
      const dateStr = fmtDate(post.publishedAt);
      const li   = document.createElement('li');
      li.className = 'busca-result';

      const a = document.createElement('a');
      a.href = `/posts/${post.slug}`;
      a.className = 'busca-result-link';

      const top = document.createElement('div');
      top.className = 'busca-result-top';

      const cat = document.createElement('span');
      cat.className = 'busca-result-category';
      cat.textContent = post.category;

      top.appendChild(cat);

      if (dateStr) {
        const date = document.createElement('span');
        date.className = 'busca-result-date';
        date.textContent = dateStr;
        top.appendChild(date);
      }

      const title = document.createElement('h2');
      title.className = 'busca-result-title';
      title.textContent = post.title;

      const excerpt = document.createElement('p');
      excerpt.className = 'busca-result-excerpt';
      const rawExcerpt = post.excerpt ?? '';
      excerpt.textContent = rawExcerpt.length > 160 ? rawExcerpt.slice(0, 160) + '…' : rawExcerpt;

      const meta = document.createElement('div');
      meta.className = 'busca-result-meta';

      const author = document.createElement('span');
      author.className = 'busca-result-author';
      author.textContent = post.authorName;

      const arrow = document.createElement('span');
      arrow.className = 'busca-result-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '→';

      meta.appendChild(author);
      meta.appendChild(arrow);

      a.append(top, title, excerpt, meta);
      li.appendChild(a);
      listEl!.appendChild(li);
    }
  }

  function search(raw: string) {
    const q = raw.trim().toLowerCase();
    if (clearBtn) clearBtn.hidden = raw.length === 0;

    if (!q) {
      if (searchIndex.length === 0) {
        setUI({ noPosts: true });
      } else {
        setUI({ idle: true });
      }
      if (hintEl) hintEl.textContent = '';
      return;
    }

    const results = searchIndex.filter((p) =>
      p.title.toLowerCase().includes(q) ||
      p.excerpt.toLowerCase().includes(q) ||
      p.category.toLowerCase().includes(q) ||
      p.authorName.toLowerCase().includes(q),
    );

    if (results.length === 0) {
      setUI({ noResults: true });
      if (hintEl) hintEl.textContent = '';
    } else {
      render(results);
      setUI({ results: true });
      const n = results.length;
      if (hintEl) hintEl.textContent = `${n} resultado${n !== 1 ? 's' : ''} encontrado${n !== 1 ? 's' : ''}.`;
    }
  }

  // Initial state
  searchIndex.length === 0 ? setUI({ noPosts: true }) : setUI({ idle: true });

  inputEl?.addEventListener('input', (e) => search((e.target as HTMLInputElement).value));

  clearBtn?.addEventListener('click', () => {
    if (inputEl) { inputEl.value = ''; inputEl.focus(); }
    const clean = window.location.pathname;
    window.history.replaceState({}, '', clean);
    search('');
  });

  // Support ?q= URL param
  const urlQ = new URLSearchParams(window.location.search).get('q') ?? '';
  if (urlQ) {
    if (inputEl) inputEl.value = urlQ;
    search(urlQ);
  }
</script>

<style>
  .busca-page {
    min-height: 80vh;
    padding: 80px 0 64px;
  }

  .busca-container {
    width: min(720px, calc(100% - 40px));
    margin: 0 auto;
  }

  .busca-header {
    margin-bottom: 40px;
  }

  .busca-kicker {
    display: block;
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  .busca-title {
    margin: 0 0 10px;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .busca-subtitle {
    margin: 0;
    font-family: monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--color-text);
    opacity: 0.5;
  }

  .busca-api-warn {
    margin: 0 0 24px;
    padding: 12px 16px;
    border: 1px solid var(--color-accent-40);
    border-radius: 8px;
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    background: var(--color-accent-06);
  }

  .busca-field {
    margin-bottom: 32px;
  }

  .busca-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    border: 1px solid var(--color-star-22);
    border-radius: 10px;
    background: var(--color-star-05);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .busca-input-wrap:focus-within {
    border-color: var(--color-star-45);
    box-shadow: 0 0 18px var(--color-star-10);
  }

  .busca-icon {
    position: absolute;
    left: 14px;
    width: 16px;
    height: 16px;
    color: var(--color-star);
    opacity: 0.45;
    pointer-events: none;
    flex-shrink: 0;
  }

  .busca-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    padding: 14px 44px 14px 42px;
    font-family: monospace;
    font-size: 0.9rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-text);
    width: 100%;
  }

  .busca-input::placeholder {
    color: var(--color-star);
    opacity: 0.3;
  }

  /* Hide native search clear button */
  .busca-input::-webkit-search-cancel-button { display: none; }

  .busca-clear {
    position: absolute;
    right: 10px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--color-star);
    opacity: 0.5;
    cursor: pointer;
    border-radius: 50%;
    transition: opacity 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .busca-clear svg { width: 14px; height: 14px; }

  .busca-clear:hover { opacity: 1; color: var(--color-accent); }

  .busca-hint {
    margin: 8px 0 0;
    font-family: monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--color-star);
    opacity: 0.45;
    min-height: 1em;
  }

  .busca-state {
    margin: 0;
    padding: 28px 0;
    font-family: monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-star);
    opacity: 0.35;
  }

  .busca-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .busca-result-link {
    display: flex;
    flex-direction: column;
    height: 188px;
    box-sizing: border-box;
    overflow: hidden;
    padding: 20px 24px;
    border: 1px solid var(--color-star-14);
    border-radius: 12px;
    background: var(--color-star-04);
    text-decoration: none;
    transition: border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
  }

  .busca-result-link:hover,
  .busca-result-link:focus-visible {
    border-color: var(--color-star-35);
    background: var(--color-star-07);
    box-shadow: 0 0 20px var(--color-star-08);
    transform: translateY(-2px);
    outline: none;
  }

  .busca-result-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .busca-result-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .busca-result-category {
    font-family: monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-40);
    background: var(--color-accent-06);
    border-radius: 4px;
    padding: 2px 7px;
  }

  .busca-result-date {
    font-family: monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--color-text);
    opacity: 0.35;
    margin-left: auto;
  }

  .busca-result-title {
    margin: 0 0 8px;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .busca-result-excerpt {
    margin: 0 0 14px;
    font-family: monospace;
    font-size: 0.76rem;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--color-text);
    opacity: 0.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .busca-result-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
  }

  .busca-result-author {
    font-family: monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-star);
    opacity: 0.6;
  }

  .busca-result-arrow {
    font-size: 0.9rem;
    color: var(--color-accent);
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .busca-result-link:hover .busca-result-arrow,
  .busca-result-link:focus-visible .busca-result-arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 520px) {
    .busca-page { padding: 64px 0 48px; }
    .busca-container { width: calc(100% - 32px); }
    .busca-result-link {
      height: 220px;
      padding: 16px 18px;
    }
    .busca-result-date { display: none; }
  }
</style>
