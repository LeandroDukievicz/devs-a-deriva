{
  "name": "devs-a-deriva",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "lint": "node scripts/lint.mjs",
    "typecheck": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:security": "npm audit --audit-level=high && node scripts/check-security.mjs",
    "smoke:test": "node scripts/smoke-test.mjs",
    "ci:check": "npm run lint && npm run typecheck && npm run validate:content && npm test",
    "build": "astro build",
    "preview": "astro preview",
    "lighthouse": "lhci autorun",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:ci": "npm run ci:check && npm run test:e2e && npm run check:security"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.1",
    "@astrojs/vercel": "^10.0.7",
    "@oslojs/encoding": "1.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vercel/analytics": "^2.0.1",
    "aeo.js": "^0.0.13",
    "astro": "^6.3.1",
    "clsx": "2.1.1",
    "cookie": "1.1.1",
    "devalue": "5.8.1",
    "html-escaper": "3.0.3",
    "mrmime": "2.0.1",
    "piccolore": "0.1.3",
    "send": "0.19.2",
    "server-destroy": "1.0.1",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.0",
    "unstorage": "1.17.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@vitest/ui": "^4.1.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "yaml": ">=2.9.0",
    "tmp": ">=0.2.6",
    "@vercel/routing-utils": {
      "path-to-regexp": ">=6.3.0"
    }
  }
}
